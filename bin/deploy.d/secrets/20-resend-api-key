#!/usr/bin/env bash
#
# RESEND_API_KEY → the control app's `wrangler secret` ([[REQ-196]]).
#
# The sender is an HTTPS call to Resend — a Worker has no SMTP and Cloudflare's
# own `send_email` binding delivers only to addresses already verified in the
# account, which is exactly the set an invitee is not in. So there is a bearer
# credential, and this is what puts it where `mail.ts` reads it from.
#
# A SECRET AND NOT A VAR, for the reason `10-anthropic-api-key` states: a
# `[vars]` entry is readable by anyone with dashboard access and printed in
# deploy output, and this one can send mail as `1stcontact.io`. The value is
# never in this file and never in the repository.
#
# IT WARNS WHERE THE MODEL KEY FAILS, AND THE DIFFERENCE IS DELIBERATE.
# `10-anthropic-api-key` aborts the deploy when the key exists nowhere, because
# a control app that cannot take a turn is a control app that does nothing. Mail
# is not that yet: nothing in this repository sends a message — the invite is a
# database transition and the message itself is [[REQ-197]]'s — and the sending
# DOMAIN is an operator task with waiting in it (SPF, DKIM and DMARC on
# `1stcontact.io`; see apps/control-app/MAIL.md). Aborting every deploy until
# that DNS is verified would stop the pipeline over a capability with no caller.
#
# So absent is a LOUD WARNING and an exit 0, and what it warns about is precise:
# with no key the Worker selects the local adapter, which records and delivers
# nothing. That is the failure [[REQ-196]] exists to prevent an operator
# assuming their way past, said at the one moment they are looking.
#
# WHEN A CALLER LANDS, THIS BECOMES A FAILURE. The moment a route can send —
# [[REQ-197]] — a deployment without the key silently sends nothing, and the
# three-way decision below is already the right shape for it: change `warn` to
# `fail` and the message is already written.
#
# THE GUARD IS ABOUT THE STORE, NOT THE SHELL, which is `10-anthropic-api-key`'s
# correction and applies unchanged here:
#
#   in the environment?  -> push it (supplying a value is how a rotation is
#                           expressed, even when the name is already there)
#   else already stored? -> leave it alone, and say so
#   else                 -> warn, before anything is uploaded
#
# ASYMMETRY IS DELIBERATE. Only a positive read — the store answered, and the
# name was in the answer — counts as present. A `secret list` that fails for any
# reason (no such Worker on a first deploy, no network, a token without Workers
# Scripts read) is treated as absent, because the failure being guarded against
# is a confident skip based on an answer nobody actually got.
# AND PRESENCE IS NOT CAPABILITY ([[REQ-264]]). This hook checked that a value
# existed, found that it did, and passed — while the value was a Resend
# **Sending access** key, which sends mail and answers 401 to `GET /domains`.
# The domain section therefore shipped offering a sending toggle it could never
# honour: the exact condition `resend.ts` names as *"worse than not offering
# it"*. So a supplied value is now PROBED against the call the product actually
# makes, and the three answers are three different claims:
#
#   full access  -> push, and say what it can do
#   sending-only -> push ANYWAY and WARN LOUDLY. The key still sends every
#                   invite this product sends, and the runtime now reports
#                   sending as unavailable rather than showing Resend's English
#                   to a customer — so the deployment degrades exactly as one
#                   with no key at all does, which REQ-259 already ruled
#                   ordinary. Degrading is allowed; degrading silently is not.
#   refused      -> FAIL. A key Resend does not recognise is not a deliberate
#                   state, it is an operator error: the Worker selects the
#                   Resend adapter over the local one and every send errors,
#                   which is worse than the absent case this hook forgives.
#
# A STORED VALUE CANNOT BE PROBED, and the report says so rather than passing it.
# `wrangler secret list` answers with names; the value itself is unreadable by
# design, so a deploy that changes nothing proves nothing and must not claim to.
set -euo pipefail

# One secret per hook, named after it. Only the control app sends mail;
# `public-site` serves rendered bytes and must not carry a sending credential.
[[ "$DEPLOY_APP" == "control-app" ]] || exit 0

# The shared mechanism — store reads, capability probes, report rows. The
# DECISION TABLE below stays here, because it is this credential's own claim
# about what its absence costs ([[REQ-264]]).
# shellcheck source=../lib/secret.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)/secret.sh"

# THE LOCAL TARGET HAS NO SECRET STORE ([[REQ-318]]). The decision table below is
# about `wrangler secret`, which the local dev environment does not have and does
# not want — it reads the `--env-file` layering instead. A supplied value is still
# probed, so the capability report is real; see `secret_local_target`.
if secret_local_target RESEND_API_KEY; then
  exit 0
fi

if [[ -n "${RESEND_API_KEY:-}" ]]; then
  action=push
else
  case "$(secret_in_store RESEND_API_KEY)" in
    present) action=keep ;;
    absent) action=warn state=absent reason="the Worker has no RESEND_API_KEY either" ;;
    unreadable) action=warn state=unreadable reason="and its secrets could not be read to check" ;;
  esac
fi

# THE PROBE RUNS BEFORE THE PUSH and before the upload, on this directory's
# standing rule that a hook fails ahead of `wrangler deploy` rather than after
# it. It is a read, so it runs unchanged on a rehearsal.
capability=0
if [[ "$action" == "push" ]]; then
  set +e
  capability_probe RESEND_API_KEY
  capability=$?
  set -e
  if [[ "$capability" == "3" ]]; then action=broken; fi
fi

if [[ "$action" == "broken" ]]; then
  cat >&2 <<EOF
bin/deploy: RESEND_API_KEY is set, and Resend does not recognise it.
  $DEPLOY_WORKER_NAME would select the Resend sender and every message it tried
  to send would fail — which is worse than having no key at all, where the local
  adapter is chosen deliberately. Nothing has been uploaded.

  Check the key in your password manager against the one in the Resend
  dashboard, then deploy again.
EOF
  exit 1
fi

if [[ "$action" == "warn" ]]; then
  capability_record RESEND_API_KEY "$state"
  cat >&2 <<EOF
bin/deploy: RESEND_API_KEY is not set in your environment, $reason.
  $DEPLOY_WORKER_NAME will run the LOCAL mail adapter, which records messages
  and delivers none of them — nothing this deployment sends will arrive. That is
  survivable today because nothing sends yet; it will not be once a route does.

  To fix it, add the domain in Resend, publish the SPF/DKIM/DMARC records it
  gives you (apps/control-app/MAIL.md), then:

    export RESEND_API_KEY='...'   # from your password manager

  Nothing needs to be exported once the secret is in place — a later deploy
  reads the name back off $DEPLOY_WORKER_NAME and leaves the value alone.
EOF
  exit 0
fi

# A SENDING-ONLY KEY IS A DEGRADED DEPLOYMENT AND IS SAID OUT LOUD. The push
# still happens below: this key sends, and refusing to store it would break the
# one capability it does have.
if [[ "$capability" == "2" ]]; then
  cat >&2 <<EOF
bin/deploy: RESEND_API_KEY works, but only for SENDING.
  Resend refused the domain API, so this is a *Sending access* key and the
  domain API needs *Full access*. $DEPLOY_WORKER_NAME will send mail and will
  NOT offer the \`Send email from this domain\` toggle in \`Your domain\` — a
  customer sees a working website and mail that still comes from 1st Contact.

  To fix it, mint a Full access key in the Resend dashboard and deploy again.
EOF
elif [[ "$capability" != "0" ]]; then
  echo "    RESEND_API_KEY could not be probed — nothing is claimed about it" >&2
fi

# A rehearsal reports the decision it would have acted on. It reaches this line
# by the same route as the real thing — including the warnings above, so
# `--dry-run` tells you what the deploy would leave behind.
if [[ "${DEPLOY_DRY_RUN:-0}" == "1" ]]; then
  case "$action" in
    push) echo "    would push RESEND_API_KEY to $DEPLOY_WORKER_NAME" ;;
    keep)
      capability_record RESEND_API_KEY stored
      echo "    RESEND_API_KEY already on $DEPLOY_WORKER_NAME — would leave it"
      ;;
  esac
  exit 0
fi

if [[ "$action" == "keep" ]]; then
  capability_record RESEND_API_KEY stored
  echo "    RESEND_API_KEY already on $DEPLOY_WORKER_NAME — left alone, not probed"
  exit 0
fi

printf '%s' "$RESEND_API_KEY" |
  (cd "$DEPLOY_APP_DIR" && npx wrangler secret put RESEND_API_KEY --env "$DEPLOY_ENV")
echo "    pushed RESEND_API_KEY to $DEPLOY_WORKER_NAME"
