#!/usr/bin/env bash
#
# OPENAI_API_KEY → the control app's `wrangler secret` ([[REQ-208]]).
#
# THE FIRST NON-ANTHROPIC CREDENTIAL THIS PRODUCT DEPLOYS. The assistant's
# `create_image` tool reaches OpenAI's images API underneath, because Anthropic
# does not generate images. It is an IMAGE credential and not a chat backend:
# the session still runs on Claude, and one tool goes somewhere else.
#
# A SECRET AND NOT A VAR, for the reason 10-anthropic-api-key gives at length —
# it is a bearer credential for a paid API, and a `[vars]` entry is readable in
# the dashboard and echoed by `wrangler deploy`.
#
# WHERE THIS DELIBERATELY DIFFERS FROM THE ANTHROPIC HOOK, and it is the whole
# reason it is a separate file rather than a second name in that one:
#
#   ANTHROPIC_API_KEY absent -> FAIL the deploy. Nothing in the product works
#                               without it; a builder that cannot take a turn is
#                               a broken deploy that looks fine.
#   OPENAI_API_KEY    absent -> DEPLOY ANYWAY, and say so. Having no image
#                               generator is an ORDINARY STATE, not a fault: the
#                               plugin declares the credential it needs, drops
#                               out of the tool surface and out of the manual
#                               when nothing supplies it, and every other tool
#                               keeps working. `aiConfigured` does not read it
#                               either, for the same reason.
#
# Failing here would enforce a capability the product treats as optional, and
# would stop a deploy that is entirely correct.
#
# THE VALUE IS NEVER IN THIS FILE, and never in the repository. It is read from
# the operator's own environment at deploy time, which is why this script
# contains the NAME and the push and nothing else.
set -euo pipefail

# Only the control app has an assistant; `public-site` serves rendered bytes and
# must not carry a model credential of any vendor.
[[ "$DEPLOY_APP" == "control-app" ]] || exit 0

# Names are the only half that is safe to look at, and reading them changes
# nothing — so this runs unchanged on a rehearsal. Not called at all when the
# environment already has the value, so the common path adds no round-trip.
probe_store() {
  local json
  if ! json="$(cd "$DEPLOY_APP_DIR" && npx wrangler secret list --env "$DEPLOY_ENV" 2>/dev/null)"; then
    echo unreadable
  elif printf '%s' "$json" | grep -q '"name"[[:space:]]*:[[:space:]]*"OPENAI_API_KEY"'; then
    echo present
  else
    echo absent
  fi
}

if [[ -n "${OPENAI_API_KEY:-}" ]]; then
  action=push
else
  case "$(probe_store)" in
    present) action=keep ;;
    # BOTH NON-FAILING, and the asymmetry with the Anthropic hook is the point.
    # An unreadable store is reported as skipped rather than guessed at, because
    # a confident "already there" based on an answer nobody got is the one thing
    # worth being careful about even where the consequence is only a missing
    # capability.
    absent) action=skip reason="this deployment will have no image generation" ;;
    unreadable) action=skip reason="and its secrets could not be read to check" ;;
  esac
fi

if [[ "${DEPLOY_DRY_RUN:-0}" == "1" ]]; then
  case "$action" in
    push) echo "    would push OPENAI_API_KEY to $DEPLOY_WORKER_NAME" ;;
    keep) echo "    OPENAI_API_KEY already on $DEPLOY_WORKER_NAME — would leave it" ;;
    skip) echo "    OPENAI_API_KEY not set, $reason — would deploy without it" ;;
  esac
  exit 0
fi

if [[ "$action" == "keep" ]]; then
  echo "    OPENAI_API_KEY already on $DEPLOY_WORKER_NAME — left alone"
  exit 0
fi

if [[ "$action" == "skip" ]]; then
  echo "    OPENAI_API_KEY not set, $reason — the assistant will have no image tool"
  exit 0
fi

printf '%s' "$OPENAI_API_KEY" |
  (cd "$DEPLOY_APP_DIR" && npx wrangler secret put OPENAI_API_KEY --env "$DEPLOY_ENV")
echo "    pushed OPENAI_API_KEY to $DEPLOY_WORKER_NAME"
