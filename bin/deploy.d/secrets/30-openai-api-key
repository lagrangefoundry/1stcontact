#!/usr/bin/env bash
#
# OPENAI_API_KEY → the control app's `wrangler secret` ([[REQ-208]]).
#
# THE FIRST NON-ANTHROPIC CREDENTIAL THIS PRODUCT DEPLOYS. The assistant's
# `create_image` tool reaches OpenAI's images API underneath, because Anthropic
# does not generate images. It is an IMAGE credential and not a chat backend:
# the session still runs on Claude, and one tool goes somewhere else.
#
# A SECRET AND NOT A VAR, for the reason 10-anthropic-api-key gives at length —
# it is a bearer credential for a paid API, and a `[vars]` entry is readable in
# the dashboard and echoed by `wrangler deploy`.
#
# WHERE THIS DELIBERATELY DIFFERS FROM THE ANTHROPIC HOOK, and it is the whole
# reason it is a separate file rather than a second name in that one:
#
#   ANTHROPIC_API_KEY absent -> FAIL the deploy. Nothing in the product works
#                               without it; a builder that cannot take a turn is
#                               a broken deploy that looks fine.
#   OPENAI_API_KEY    absent -> DEPLOY ANYWAY, and say so. Having no image
#                               generator is an ORDINARY STATE, not a fault: the
#                               plugin declares the credential it needs, drops
#                               out of the tool surface and out of the manual
#                               when nothing supplies it, and every other tool
#                               keeps working. `aiConfigured` does not read it
#                               either, for the same reason.
#
# Failing here would enforce a capability the product treats as optional, and
# would stop a deploy that is entirely correct.
#
# THE VALUE IS NEVER IN THIS FILE, and never in the repository. It is read from
# the operator's own environment at deploy time, which is why this script
# contains the NAME and the push and nothing else.
# AND PRESENCE IS NOT CAPABILITY ([[REQ-264]]), which lands on this hook in its
# own shape. Having NO key is an ordinary state and stays one — the plugin drops
# out of the tool surface and out of the manual, and every other tool keeps
# working. Having a key OpenAI refuses is not that state: the plugin declares
# itself configured, the tool is offered, and every image a customer asks for
# fails. So a supplied value is PROBED with `GET /v1/models` — the key's
# authentication and organisation, which is what `create_image` needs and what a
# probe can establish without generating an image — and a refusal FAILS the
# deploy. An operator who exported a key intends image generation; a dead one is
# an error, not a choice.
set -euo pipefail

# Only the control app has an assistant; `public-site` serves rendered bytes and
# must not carry a model credential of any vendor.
[[ "$DEPLOY_APP" == "control-app" ]] || exit 0

# The shared mechanism — store reads, capability probes, report rows. The
# decision table below stays here, because it is this credential's own claim
# about what its absence costs ([[REQ-264]]).
# shellcheck source=../lib/secret.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)/secret.sh"

# THE LOCAL TARGET HAS NO SECRET STORE ([[REQ-318]]). The decision table below is
# about `wrangler secret`, which the local dev environment does not have and does
# not want — it reads the `--env-file` layering instead. A supplied value is still
# probed, so the capability report is real; see `secret_local_target`.
if secret_local_target OPENAI_API_KEY; then
  exit 0
fi

if [[ -n "${OPENAI_API_KEY:-}" ]]; then
  action=push
else
  case "$(secret_in_store OPENAI_API_KEY)" in
    present) action=keep ;;
    # BOTH NON-FAILING, and the asymmetry with the Anthropic hook is the point.
    # An unreadable store is reported as skipped rather than guessed at, because
    # a confident "already there" based on an answer nobody got is the one thing
    # worth being careful about even where the consequence is only a missing
    # capability.
    absent) action=skip state=absent reason="this deployment will have no image generation" ;;
    unreadable) action=skip state=unreadable reason="and its secrets could not be read to check" ;;
  esac
fi

capability=0
if [[ "$action" == "push" ]]; then
  set +e
  capability_probe OPENAI_API_KEY
  capability=$?
  set -e
  if [[ "$capability" == "3" ]]; then action=refused; fi
fi

if [[ "$action" == "refused" ]]; then
  cat >&2 <<EOF
bin/deploy: OPENAI_API_KEY is set, and OpenAI does not accept it.
  Having no image generator is an ordinary state and this hook forgives it. A
  key that is refused is a different thing: the tool would be OFFERED to the
  assistant and every image a customer asked for would fail. Nothing has been
  uploaded.

  Either fix the key, or unset it — an absent key removes the tool cleanly.
EOF
  exit 1
fi

if [[ "$capability" != "0" ]]; then
  echo "    OPENAI_API_KEY could not be probed — nothing is claimed about it" >&2
fi

if [[ "${DEPLOY_DRY_RUN:-0}" == "1" ]]; then
  case "$action" in
    push) echo "    would push OPENAI_API_KEY to $DEPLOY_WORKER_NAME" ;;
    keep)
      capability_record OPENAI_API_KEY stored
      echo "    OPENAI_API_KEY already on $DEPLOY_WORKER_NAME — would leave it"
      ;;
    skip)
      capability_record OPENAI_API_KEY "$state"
      echo "    OPENAI_API_KEY not set, $reason — would deploy without it"
      ;;
  esac
  exit 0
fi

if [[ "$action" == "keep" ]]; then
  capability_record OPENAI_API_KEY stored
  echo "    OPENAI_API_KEY already on $DEPLOY_WORKER_NAME — left alone, not probed"
  exit 0
fi

if [[ "$action" == "skip" ]]; then
  capability_record OPENAI_API_KEY "$state"
  echo "    OPENAI_API_KEY not set, $reason — the assistant will have no image tool"
  exit 0
fi

printf '%s' "$OPENAI_API_KEY" |
  (cd "$DEPLOY_APP_DIR" && npx wrangler secret put OPENAI_API_KEY --env "$DEPLOY_ENV")
echo "    pushed OPENAI_API_KEY to $DEPLOY_WORKER_NAME"
