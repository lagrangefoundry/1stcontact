#!/usr/bin/env bash
#
# CLOUDFLARE_DNS_TOKEN → the control app's `wrangler secret` ([[REQ-257]]).
#
# WHAT IT IS FOR. `apps/control-app/src/cloudflare.ts` manages the zones this
# deployment holds DNS for: listing them, reading their status and assigned
# nameservers, writing records, and attaching a Worker route. Every one of those
# is an authenticated call to `api.cloudflare.com`, so there is a bearer
# credential, and this is what puts it where that module reads it from.
#
# A SECRET AND NOT A VAR, for the reason `10-anthropic-api-key` states and with a
# sharper edge here: a `[vars]` entry is readable by anyone with dashboard access
# and printed in deploy output, and this one can rewrite the DNS of every domain
# this deployment manages — including the MX records that carry a customer's
# mail. The value is never in this file and never in the repository, and a UAT
# fails the build if it appears in `wrangler.toml`.
#
# THE SCOPE IS PART OF THE DESIGN AND NOT AN OPERATIONAL DETAIL. Mint it with
# `Zone:DNS:Edit` and `Workers Routes:Edit` on the account, and NOTHING ELSE.
# The client's eleven enumerated operations are exactly what that scope admits;
# a token with more is a token whose blast radius nobody can read off the code.
#
# AND IT IS DELIBERATELY NOT `CLOUDFLARE_API_TOKEN`, which this deployment
# already has a meaning for: `embedder.ts` reads it with `CLOUDFLARE_ACCOUNT_ID`
# as the REST transport for Workers AI ([[BUG-73]]). That pair is
# both-or-neither and a Workers-AI token cannot touch a zone, so sharing the
# name would break one capability to configure the other.
#
# NO ACCOUNT ID IS PUSHED BESIDE IT, because the account id is not
# configuration: every zone Cloudflare returns carries its own `account.id`, so
# the client reads it from the zones the token can already see. One value, one
# hook, nothing to keep in step.
#
# IT WARNED UNTIL A CALLER LANDED, AND NOW IT FAILS. [[REQ-257]] wrote this as
# a warning on `20-resend-api-key`'s reasoning — it was the DNS layer and
# nothing that used it, so a deployment without the token answered 503 to an
# operator and customers noticed nothing, and aborting every deploy over a
# capability nobody could ask for would have stopped the pipeline for no one's
# benefit. It said what would end that: *"the moment serving a custom domain
# depends on it, a deployment without the key cannot publish a customer's site
# to their own address."*
#
# [[REQ-259]] IS THAT MOMENT. `Your domain` is on the Settings pane, and every
# control in it goes through this credential: the selector reads the account's
# zones, the attach writes records and a route, the sending toggle writes three
# more, and release takes them all down. Without the token that section can
# draw a pool it cannot spend and a button that cannot work — which is worse
# than the 503 it replaced, because the 503 was only ever seen by an operator
# who could read it. So the three-way decision below is the shape REQ-257 left
# for exactly this, taken: `warn` is now `fail`, and the message it was already
# carrying is the one that prints.
#
# `20-resend-api-key` DOES NOT MOVE WITH IT, and the asymmetry is the point.
# REQ-259 is a caller of that key too, and it is deliberately survivable without
# one: the domain still attaches, the website still serves, and the toggle
# reports `off`. A missing sending credential costs a feature; a missing zone
# credential costs the whole section.
#
# THE GUARD IS ABOUT THE STORE, NOT THE SHELL:
#
#   in the environment?  -> push it (supplying a value is how a rotation is
#                           expressed, even when the name is already there)
#   else already stored? -> leave it alone, and say so
#   else                 -> fail, loudly, before anything is uploaded
#
# ASYMMETRY IS DELIBERATE. Only a positive read — the store answered, and the
# name was in the answer — counts as present. A `secret list` that fails for any
# reason is treated as absent, because the failure being guarded against is a
# confident skip based on an answer nobody actually got.
set -euo pipefail

# One secret per hook, named after it. Only the control app manages DNS;
# `public-site` serves rendered bytes and must not carry a zone credential.
[[ "$DEPLOY_APP" == "control-app" ]] || exit 0

probe_store() {
  local json
  if ! json="$(cd "$DEPLOY_APP_DIR" && npx wrangler secret list --env "$DEPLOY_ENV" 2>/dev/null)"; then
    echo unreadable
  elif printf '%s' "$json" | grep -q '"name"[[:space:]]*:[[:space:]]*"CLOUDFLARE_DNS_TOKEN"'; then
    echo present
  else
    echo absent
  fi
}

if [[ -n "${CLOUDFLARE_DNS_TOKEN:-}" ]]; then
  action=push
else
  case "$(probe_store)" in
    present) action=keep ;;
    absent) action=fail reason="the Worker has no CLOUDFLARE_DNS_TOKEN either" ;;
    unreadable) action=fail reason="and its secrets could not be read to check" ;;
  esac
fi

if [[ "$action" == "fail" ]]; then
  cat >&2 <<EOF
bin/deploy: CLOUDFLARE_DNS_TOKEN is not set in your environment, $reason.
  $DEPLOY_WORKER_NAME would manage no DNS, and a customer surface now depends
  on it: the Settings pane's \`Your domain\` section would offer a selector it
  cannot spend and an attach button that cannot work. Refusing the deploy is
  cheaper than shipping that.

  To fix it, mint a Cloudflare API token scoped to Zone:DNS:Edit and
  Workers Routes:Edit on the account — and nothing else — then:

    export CLOUDFLARE_DNS_TOKEN='...'   # from your password manager

  Nothing needs to be exported once the secret is in place — a later deploy
  reads the name back off $DEPLOY_WORKER_NAME and leaves the value alone.
EOF
  exit 1
fi

# A rehearsal reports the decision it would have acted on.
if [[ "${DEPLOY_DRY_RUN:-0}" == "1" ]]; then
  case "$action" in
    push) echo "    would push CLOUDFLARE_DNS_TOKEN to $DEPLOY_WORKER_NAME" ;;
    keep) echo "    CLOUDFLARE_DNS_TOKEN already on $DEPLOY_WORKER_NAME — would leave it" ;;
  esac
  exit 0
fi

if [[ "$action" == "keep" ]]; then
  echo "    CLOUDFLARE_DNS_TOKEN already on $DEPLOY_WORKER_NAME — left alone"
  exit 0
fi

printf '%s' "$CLOUDFLARE_DNS_TOKEN" |
  (cd "$DEPLOY_APP_DIR" && npx wrangler secret put CLOUDFLARE_DNS_TOKEN --env "$DEPLOY_ENV")
echo "    pushed CLOUDFLARE_DNS_TOKEN to $DEPLOY_WORKER_NAME"
