#!/usr/bin/env bash
#
# ANTHROPIC_API_KEY → the control app's `wrangler secret` (REQ-146).
#
# The builder's assistant runs in workerd now, and a Worker has no
# `process.env` to read a key out of. `router.ts` takes it off `env` and hands
# it to the backend; this is what puts it there.
#
# A SECRET AND NOT A VAR. `wrangler secret` values are write-only — the
# dashboard shows the name and never the value, and `wrangler deploy` does not
# echo it — which is the difference that matters for a bearer credential to a
# paid API. A `[vars]` entry would be readable by anyone with dashboard access
# and printed in deploy output.
#
# THE VALUE IS NEVER IN THIS FILE, and never in the repository. It is read from
# the operator's own environment or password manager at deploy time, which is
# why this script contains the NAME and the push and nothing else.
#
# WHAT THE GUARD IS ACTUALLY FOR (REQ-149). The rule is "never deploy a control
# app that cannot take a turn", and that is a statement about the *store*, not
# about the operator's shell. An earlier version of this hook tested the shell
# and so failed a deploy whose secret had been in place for weeks — it demanded
# the operator re-supply a value Cloudflare already held, to overwrite it with
# itself. So the question asked here is the one that matters:
#
#   in the environment?  -> push it (an operator who supplies a value means to
#                           rotate it, and a push is how a rotation happens)
#   else already stored? -> leave it alone, and say so
#   else                 -> fail, loudly, before anything is uploaded
#
# Absent is an ordinary state at RUNTIME — a builder with no key still opens the
# conversation and still shows its history, and says why it cannot take a turn —
# but it is a failure at DEPLOY time, because a deploy that silently skipped the
# secret is a deploy that looks fine and refuses every turn later. Skipping
# *knowingly*, having read the name back out of the store, is not that.
#
# ASYMMETRY IS DELIBERATE. Only a positive read — the store answered, and the
# name was in the answer — is allowed to satisfy the guard. A `secret list` that
# fails for any reason (no such Worker on a first deploy, no network, a token
# without Workers Scripts read) is treated as "not there", because the failure
# mode we are protecting against is a confident skip based on an answer nobody
# actually got.
# AND PRESENCE IS NOT CAPABILITY ([[REQ-264]]). A revoked key, or one scoped to
# the wrong organisation, satisfied every check this hook made and then failed on
# the first turn a customer took. So a supplied value is PROBED — `GET
# /v1/models`, which exercises exactly the authentication and organisation a turn
# needs and bills nothing — and a key Anthropic refuses fails the deploy on the
# same reasoning the absent row already fails it: a control app that cannot take
# a turn is a broken deploy that looks fine.
#
# A STORED VALUE CANNOT BE PROBED. `wrangler secret list` answers with names, so
# a deploy that changes nothing proves nothing and the report says `unverified`
# rather than passing it.
set -euo pipefail

# One secret per hook, named after it: 10-anthropic-api-key
[[ "$DEPLOY_APP" == "control-app" ]] || exit 0

# The shared mechanism — store reads, capability probes, report rows. The
# decision table below stays here, because it is this credential's own claim
# about what its absence costs ([[REQ-264]]).
# shellcheck source=../lib/secret.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)/secret.sh"

# THE LOCAL TARGET HAS NO SECRET STORE ([[REQ-318]]). The decision table below is
# about `wrangler secret`, which the local dev environment does not have and does
# not want — it reads the `--env-file` layering instead. A supplied value is still
# probed, so the capability report is real; see `secret_local_target`.
if secret_local_target ANTHROPIC_API_KEY; then
  exit 0
fi

if [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
  action=push
else
  case "$(secret_in_store ANTHROPIC_API_KEY)" in
    present) action=keep ;;
    absent) action=fail state=absent reason="the Worker has no ANTHROPIC_API_KEY either" ;;
    unreadable) action=fail state=unreadable reason="and its secrets could not be read to check" ;;
  esac
fi

# THE PROBE RUNS BEFORE THE PUSH and before the upload. It is a read, so it runs
# unchanged on a rehearsal.
capability=0
if [[ "$action" == "push" ]]; then
  set +e
  capability_probe ANTHROPIC_API_KEY
  capability=$?
  set -e
  if [[ "$capability" == "3" ]]; then action=refused; fi
fi

if [[ "$action" == "refused" ]]; then
  cat >&2 <<EOF
bin/deploy: ANTHROPIC_API_KEY is set, and Anthropic does not accept it.
  The assistant cannot take a turn with a key that is revoked or scoped to
  another organisation, so this deploy is stopping before anything is uploaded —
  the same refusal as having no key at all, for the same reason.

  Check the key in your password manager against the Anthropic console, then
  deploy again.
EOF
  exit 1
fi

if [[ "$action" == "fail" ]]; then
  capability_record ANTHROPIC_API_KEY "$state"
  cat >&2 <<EOF
bin/deploy: ANTHROPIC_API_KEY is not set in your environment, $reason.
  The control app's assistant cannot take a turn without it, so this deploy is
  stopping before anything is uploaded. Supply the value and deploy again:

    export ANTHROPIC_API_KEY='...'   # from your password manager

  Nothing needs to be exported once the secret is in place — a later deploy
  reads the name back off $DEPLOY_WORKER_NAME and leaves the value alone.
EOF
  exit 1
fi

if [[ "$capability" != "0" ]]; then
  echo "    ANTHROPIC_API_KEY could not be probed — nothing is claimed about it" >&2
fi

# A rehearsal reports the decision it would have acted on. It reaches this line
# by the same route as the real thing — including the failure above, so
# `--dry-run` tells you whether the deploy would stop.
if [[ "${DEPLOY_DRY_RUN:-0}" == "1" ]]; then
  case "$action" in
    push) echo "    would push ANTHROPIC_API_KEY to $DEPLOY_WORKER_NAME" ;;
    keep)
      capability_record ANTHROPIC_API_KEY stored
      echo "    ANTHROPIC_API_KEY already on $DEPLOY_WORKER_NAME — would leave it"
      ;;
  esac
  exit 0
fi

if [[ "$action" == "keep" ]]; then
  capability_record ANTHROPIC_API_KEY stored
  echo "    ANTHROPIC_API_KEY already on $DEPLOY_WORKER_NAME — left alone, not probed"
  exit 0
fi

printf '%s' "$ANTHROPIC_API_KEY" |
  (cd "$DEPLOY_APP_DIR" && npx wrangler secret put ANTHROPIC_API_KEY --env "$DEPLOY_ENV")
echo "    pushed ANTHROPIC_API_KEY to $DEPLOY_WORKER_NAME"
