#!/usr/bin/env bash
#
# `bin/deploy` — deploy the Workers, and report what moved (REQ-144).
#
# ONE CODE PATH. `--dry-run` is a TARGET, not a different script: the same hook
# sequence runs, the same wrangler invocation is composed, and only the final
# `--dry-run` flag differs. A rehearsal that took a different route would prove
# nothing about the real thing.
#
# WHAT THIS SCRIPT DELIBERATELY DOES NOT KNOW. It knows nothing about D1, nothing
# about migrations, and no secret's name. Those are hooks:
#
#   bin/deploy.d/migrate/    run before the app deploys — REQ-143 lands D1 here
#   bin/deploy.d/secrets/    run before the app deploys — REQ-146 lands the API key here
#
# That is not squeamishness, it is what keeps this ticket free of a dependency on
# the store chain: the scripts ship now, and each hook arrives with the ticket
# that needs it, without this file changing.
#
# A hook is any EXECUTABLE file in one of those directories, run in sorted order.
# Non-executable files are ignored, so a README can live beside them. Each hook
# receives its context in the environment:
#
#   DEPLOY_APP          e.g. control-app
#   DEPLOY_APP_DIR      absolute path to the app directory
#   DEPLOY_ENV          the wrangler environment, e.g. production
#   DEPLOY_WORKER_NAME  the deployed Worker's name, read from wrangler.toml
#   DEPLOY_DRY_RUN      1 when rehearsing — a hook MUST make no change when set
#   DEPLOY_REPO_ROOT    absolute path to the repo root
#   DEPLOY_CAPABILITY_REPORT  a file each hook appends one JSON row to
#
# THE CAPABILITY REPORT ([[REQ-264]]). A hook used to answer one question — is
# there a value — and a key with the wrong scope passed and shipped. Hooks now
# PROBE what a supplied credential can actually do and append a row saying so,
# and this script prints every row together at the end. That placement is the
# point: what is off in the shipped product has to be readable in ONE place, at
# the moment the operator is looking, rather than inferred from four scattered
# lines they scrolled past. This file still knows no secret's name — it creates
# the file, exports it, and prints whatever the hooks wrote into it.
#
# A hook that exits non-zero aborts the deploy for that app before anything is
# uploaded. That ordering is the point: a migration that fails must stop the code
# that assumes it ran.
#
# SECRETS. Values are never committed, never written to a file in this repo, and
# never echoed. They are pushed straight into Cloudflare's store:
#
#   printf '%s' "$VALUE" | npx wrangler secret put NAME --env production
#
# read from the operator's own environment or password manager. `wrangler secret
# list --env production` shows the NAMES that exist, which is the only half that
# is safe to look at. A secret hook script therefore contains the name and the
# push, never the value; see bin/deploy.d/secrets/README.md.
#
# THE FONT MIRROR IS A TARGET, NOT A HOOK ([[REQ-315]]). Two apps serve
# `_fonts/…` but there is ONE bucket and the mirror is not per-app, so running it
# as a hook would re-read and re-hash 1.35GB once per app to transfer nothing the
# second time. `--fonts` is therefore its own invocation and deploys the mirror
# and NOTHING ELSE: a font corpus and a Worker have completely different costs
# and cadences, and naming what you want moved is cheaper than a flag that
# silently adds an hour to a code deploy. `bin/deploy` with no flag still means
# the apps.
#
#   --fonts --env production   `1c fonts publish` — the cloud bucket, over the R2
#                              REST API, with the CLOUDFLARE_API_TOKEN the rest
#                              of the release toolset already uses.
#   --fonts --env dev          `1c fonts seed` — the miniflare store `wrangler
#                              dev` reads, on this machine. The same prefix and
#                              the same key function, so `r2PlatformFonts(
#                              env.SITES)` serves local dev unchanged.
#
# Usage:
#   bin/deploy                       # every app, --env production
#   bin/deploy public-site           # one app
#   bin/deploy --dry-run             # rehearse everything
#   bin/deploy --env staging control-app
#   bin/deploy --fonts               # the platform font mirror, to the cloud
#   bin/deploy --fonts --env dev     # …and to local dev, where the work is done
#
# Exit codes: 0 success; 1 anything else (a failed hook, a failed upload).

set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$here/.." && pwd)"
cd "$repo_root"

dry_run=0
env_name="production"
fonts=0
requested=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      dry_run=1
      shift
      ;;
    --fonts)
      fonts=1
      shift
      ;;
    --env)
      env_name="${2:-}"
      if [[ -z "$env_name" ]]; then
        echo "bin/deploy: --env needs a value" >&2
        exit 1
      fi
      shift 2
      ;;
    -h | --help)
      cat <<'EOF'
bin/deploy — deploy the Workers, and report what moved.

  bin/deploy [--dry-run] [--env <name>] [app...]
  bin/deploy --fonts [--dry-run] [--env production|dev] [app...]

With no app named, every apps/*/ Worker is deployed. `--dry-run` runs the same
path and uploads nothing.

`--fonts` deploys the staged platform font mirror AND NOTHING ELSE — a 1.35GB
corpus and a Worker move on different schedules, so each is named. At
`--env production` that is the cloud R2 bucket; at `--env dev` it is the
miniflare store `wrangler dev` reads on this machine, under the same prefix and
the same key function, so local dev serves the same bytes through the same code.
There is one cloud bucket but `.wrangler/state` is per app directory, so naming
apps narrows the dev target and is refused for production. Stage the mirror
first with `1c fonts mirror` — and for a dev seed pass `--quality 9` to it,
which is roughly 20x faster than the default for about 9% more bytes.

Hooks (any executable file, sorted, run before the app's upload):
  bin/deploy.d/migrate/   schema migrations
  bin/deploy.d/secrets/   `wrangler secret put` pushes — names only, never values

Hooks see DEPLOY_APP, DEPLOY_APP_DIR, DEPLOY_ENV, DEPLOY_WORKER_NAME,
DEPLOY_DRY_RUN, DEPLOY_REPO_ROOT and DEPLOY_CAPABILITY_REPORT, and must make no
change when DEPLOY_DRY_RUN=1.

Every credential a hook is handed is PROBED against the permission the product
actually uses, and the capability report at the end says what this deployment
can and cannot do. Probes are reads, so `--dry-run` reports the same verdicts.
EOF
      exit 0
      ;;
    -*)
      echo "bin/deploy: unknown flag '$1'" >&2
      exit 1
      ;;
    *)
      requested+=("$1")
      shift
      ;;
  esac
done

# Discovered, not listed — same reason as bin/build.
all_apps=()
while IFS= read -r dir; do
  all_apps+=("$(basename "$dir")")
done < <(find apps -mindepth 2 -maxdepth 2 -name wrangler.toml | xargs -n1 dirname | sort)

if [[ ${#all_apps[@]} -eq 0 ]]; then
  echo "bin/deploy: no apps/*/wrangler.toml found — nothing to deploy" >&2
  exit 1
fi

targets=()
if [[ ${#requested[@]} -eq 0 ]]; then
  targets=("${all_apps[@]}")
else
  for want in "${requested[@]}"; do
    found=0
    for have in "${all_apps[@]}"; do
      if [[ "$want" == "$have" ]]; then
        targets+=("$want")
        found=1
      fi
    done
    if [[ $found -eq 0 ]]; then
      echo "bin/deploy: unknown app '$want' (have: ${all_apps[*]})" >&2
      exit 1
    fi
  done
fi

step() { printf '\n\033[1m==> %s\033[0m\n' "$1"; }

# THE FONT TARGET ([[REQ-315]]). It delegates to `1c fonts` rather than
# reimplementing a delivery, the same way the app deploys delegate to wrangler:
# the object set, the prefix, the key function, the digest check and the report
# are all one implementation, and the only thing this file decides is which of
# the two destinations was asked for. An incomplete mirror exits non-zero there,
# which stops this before anything claims to have shipped.
deploy_fonts() {
  local cmd=("$repo_root/bin/1c" fonts)
  case "$env_name" in
    production)
      # ONE BUCKET. A named app would imply the mirror is per-app, and publishing
      # it twice would re-read and re-hash the whole corpus to transfer nothing.
      if [[ ${#requested[@]} -gt 0 ]]; then
        echo "bin/deploy: --fonts --env production publishes one bucket, so it takes no app name." >&2
        echo "            (--env dev writes a store per app, and there an app name narrows it.)" >&2
        exit 1
      fi
      cmd+=(publish)
      ;;
    dev)
      cmd+=(seed)
      if [[ ${#requested[@]} -gt 0 ]]; then
        cmd+=(--app "$(IFS=,; echo "${requested[*]}")")
      fi
      ;;
    *)
      echo "bin/deploy: --fonts knows two environments, 'production' and 'dev' — not '$env_name'." >&2
      exit 1
      ;;
  esac
  if [[ $dry_run -eq 1 ]]; then
    cmd+=(--dry-run)
  fi
  step "platform fonts → $env_name"
  "${cmd[@]}"
}

# BEFORE THE CAPABILITY REPORT IS EVEN CREATED, because no hook runs on this
# path and a report with no rows is not a report — it is an empty section that
# reads as a clean bill of health for probes that never happened.
if [[ $fonts -eq 1 ]]; then
  if [[ $dry_run -eq 1 ]]; then
    echo "DRY RUN — what would move is reported, and nothing is written."
  fi
  deploy_fonts
  exit 0
fi

# The deployed Worker's name for an environment. Read out of wrangler.toml rather
# than assumed to equal the directory: `name` under [env.<name>] overrides the
# top-level one, and reporting the wrong name is how a deploy gets confirmed
# against a Worker nobody changed.
worker_name() {
  local app_dir="$1" env="$2"
  awk -v env="[env.$env]" '
    $0 == env { in_env = 1; next }
    /^\[/ { in_env = 0 }
    in_env && /^[[:space:]]*name[[:space:]]*=/ { gsub(/.*=[[:space:]]*"|"[[:space:]]*$/, ""); print; exit }
  ' "$app_dir/wrangler.toml" || true
}

run_hooks() {
  local kind="$1" app="$2" app_dir="$3" name="$4"
  local dir="$repo_root/bin/deploy.d/$kind"
  [[ -d "$dir" ]] || return 0

  local ran=0 hook
  for hook in "$dir"/*; do
    [[ -f "$hook" && -x "$hook" ]] || continue
    ran=1
    echo "  hook $kind/$(basename "$hook")"
    DEPLOY_APP="$app" \
      DEPLOY_APP_DIR="$app_dir" \
      DEPLOY_ENV="$env_name" \
      DEPLOY_WORKER_NAME="$name" \
      DEPLOY_DRY_RUN="$dry_run" \
      DEPLOY_REPO_ROOT="$repo_root" \
      DEPLOY_CAPABILITY_REPORT="$capability_report" \
      "$hook"
  done
  [[ $ran -eq 1 ]] || echo "  (no $kind hooks)"
}

# Where hooks write their capability rows. Removed on every exit — success,
# failure and interrupt — because a stale file would make the next deploy report
# the last one's credentials.
capability_report="$(mktemp "${TMPDIR:-/tmp}/deploy-capability.XXXXXX")"
trap 'rm -f "$capability_report"' EXIT

if [[ $dry_run -eq 1 ]]; then
  echo "DRY RUN — hooks are told not to change anything, and nothing is uploaded."
  echo "Capability probes are reads, so they run anyway and report as usual."
fi

deployed=()
for app in "${targets[@]}"; do
  app_dir="$repo_root/apps/$app"
  name="$(worker_name "$app_dir" "$env_name")"
  [[ -n "$name" ]] || name="$app"

  step "$app → $name (--env $env_name)"
  run_hooks migrate "$app" "$app_dir" "$name"
  run_hooks secrets "$app" "$app_dir" "$name"

  # Composed once. --dry-run is appended to the SAME command line the real
  # deploy uses, so the two cannot drift apart.
  cmd=(npx wrangler deploy --env "$env_name")
  if [[ $dry_run -eq 1 ]]; then
    cmd+=(--dry-run)
  fi
  (cd "$app_dir" && "${cmd[@]}")
  deployed+=("$name")
done

# THE REPORT COMES BEFORE THE DEPLOYED LIST AND AFTER THE UPLOAD, deliberately:
# it describes what the thing just uploaded can and cannot do, which is only
# answerable once every hook has run. A deploy that stopped at a hook never
# reaches this — and does not need to, because the hook that stopped it printed
# the reason it stopped.
step "Capabilities"
DEPLOY_CAPABILITY_REPORT="$capability_report" \
  node "$repo_root/bin/deploy.d/lib/probe.mjs" report

step "Deployed"
for name in "${deployed[@]}"; do
  if [[ $dry_run -eq 1 ]]; then
    printf '  %-32s (rehearsed, not uploaded)\n' "$name"
  else
    printf '  %-32s %s\n' "$name" "$env_name"
  fi
done

if [[ $dry_run -eq 0 ]]; then
  printf '\nNow prove it serves:  bin/smoke\n'
fi
