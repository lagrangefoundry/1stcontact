#!/usr/bin/env python3
"""Bump the 1stcontact project's version in the root package.json.

Usage:
  ./bin/project/xgd_version_bump            # bump patch  (X.Y.Z -> X.Y.Z+1)
  ./bin/project/xgd_version_bump --minor    # bump minor  (X.Y.Z -> X.Y+1.0)
  ./bin/project/xgd_version_bump --major    # bump major  (X.Y.Z -> X+1.0.0)
  ./bin/project/xgd_version_bump --check <sha> [<sha> ...] --version X.Y.Z
  ./bin/project/xgd_version_bump --list-paths   # print paths this script writes
  ./bin/project/xgd_version_bump --help

Default behaviour is patch bump — use this at the end of every code / config /
YAML cycle before committing, per the project's pip-install-no-op convention.

--minor and --major are user-driven decisions (release-shape changes). They
reset every lower segment to zero.

--check <sha> [<sha> ...] --version X.Y.Z verifies that at least one of the
given commits introduced the version string X.Y.Z into the root package.json.
Exits 0 if found, non-zero otherwise. Used by `xgd ticket move-to-free-coded`
to confirm the version bump is present in the recorded commits before marking
a ticket free_coded.

--list-paths prints (one per line) the file paths this script writes during a
bump. Used by the dispatcher's dep-discovery walk (BUG-272) to exclude
version-bump-only file overlap from the dep signal — every commit touches
these files by convention, so without exclusion they flood ``depends_on`` with
false positives.

The single source of truth for the project's version is the root
``package.json`` ``"version"`` field. The version is otherwise unused by the
Cloudflare Workers runtime; it exists purely to satisfy the XGD bump
convention.

Exits non-zero on any error (file missing, version line missing, bad format,
malformed argv).
"""

from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path


REPO_ROOT = Path(__file__).resolve().parents[2]
VERSION_FILE = REPO_ROOT / "package.json"
# Match the JSON "version": "X.Y.Z" field, capturing the three numeric segments.
VERSION_RE = re.compile(r'("version"\s*:\s*")(\d+)\.(\d+)\.(\d+)(")')

# Paths this script writes during a bump. Surfaced via --list-paths so the
# dispatcher's dep-discovery walk can exclude version-bump-only file overlap
# from the dep signal (BUG-272).
WRITTEN_PATHS = [
    "package.json",
]


def _usage(stream=sys.stderr) -> None:
    print(__doc__.split("\n\n", 1)[0].strip(), file=stream)
    print(file=stream)
    print("Run with --help for full usage.", file=stream)


def _help() -> None:
    print(__doc__.strip())


def _parse_check_args(argv: list[str]) -> tuple[list[str], str]:
    """Parse --check <sha...> --version X.Y.Z.  Returns (shas, version)."""
    shas: list[str] = []
    version: str | None = None
    i = 0
    while i < len(argv):
        if argv[i] == "--version":
            if i + 1 >= len(argv):
                print("ERROR: --check requires --version X.Y.Z", file=sys.stderr)
                sys.exit(2)
            version = argv[i + 1]
            i += 2
        else:
            shas.append(argv[i])
            i += 1
    if not shas:
        print("ERROR: --check requires at least one SHA", file=sys.stderr)
        sys.exit(2)
    if version is None:
        print("ERROR: --check requires --version X.Y.Z", file=sys.stderr)
        sys.exit(2)
    return shas, version


def _check_version_in_commits(shas: list[str], version: str) -> int:
    """Return 0 if any SHA's package.json contains "version": "<version>"."""
    needle = re.compile(r'"version"\s*:\s*"' + re.escape(version) + r'"')
    rel_path = WRITTEN_PATHS[0]  # "package.json"
    for sha in shas:
        try:
            result = subprocess.run(
                ["git", "show", f"{sha}:{rel_path}"],
                cwd=str(REPO_ROOT),
                capture_output=True,
                text=True,
            )
            if result.returncode == 0 and needle.search(result.stdout):
                return 0
        except Exception:
            pass
    print(
        f"ERROR: version {version!r} not found in any of the provided commits.\n"
        f"Run ./bin/project/xgd_version_bump, stage the change, then commit.",
        file=sys.stderr,
    )
    return 1


def _parse_args(argv: list[str]) -> str:
    """Return the bump segment ('patch' | 'minor' | 'major') or raise SystemExit."""
    if len(argv) == 0:
        return "patch"
    arg = argv[0]
    if arg in ("--help", "-h"):
        _help()
        sys.exit(0)
    if arg == "--list-paths":
        for p in WRITTEN_PATHS:
            print(p)
        sys.exit(0)
    if arg == "--check":
        shas, version = _parse_check_args(argv[1:])
        sys.exit(_check_version_in_commits(shas, version))
    if len(argv) > 1:
        print(f"ERROR: too many arguments: {argv}", file=sys.stderr)
        _usage()
        sys.exit(2)
    if arg == "--minor":
        return "minor"
    if arg == "--major":
        return "major"
    if arg == "--patch":
        return "patch"
    print(f"ERROR: unknown flag '{arg}'", file=sys.stderr)
    _usage()
    sys.exit(2)


def _bump(major: int, minor: int, patch: int, segment: str) -> tuple[int, int, int]:
    if segment == "patch":
        return major, minor, patch + 1
    if segment == "minor":
        return major, minor + 1, 0
    if segment == "major":
        return major + 1, 0, 0
    raise ValueError(f"unknown segment '{segment}'")


def main(argv: list[str]) -> int:
    segment = _parse_args(argv)

    if not VERSION_FILE.exists():
        print(f"ERROR: version file not found: {VERSION_FILE}", file=sys.stderr)
        return 1

    text = VERSION_FILE.read_text()
    match = VERSION_RE.search(text)
    if not match:
        print(
            f'ERROR: no `"version": "X.Y.Z"` field found in {VERSION_FILE}',
            file=sys.stderr,
        )
        return 1

    prefix, major_s, minor_s, patch_s, suffix = match.groups()
    major, minor, patch = int(major_s), int(minor_s), int(patch_s)
    new_major, new_minor, new_patch = _bump(major, minor, patch, segment)

    new_version = f"{new_major}.{new_minor}.{new_patch}"
    new_line = f"{prefix}{new_version}{suffix}"
    new_text = text[: match.start()] + new_line + text[match.end():]

    VERSION_FILE.write_text(new_text)

    old_version = f"{major}.{minor}.{patch}"
    print(f"{old_version} -> {new_version}  ({segment})")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
