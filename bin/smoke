#!/usr/bin/env bash
#
# `bin/smoke` — prove a deployed origin actually serves (REQ-144).
#
# A thin launcher, matching `bin/1c`: the repo root is resolved from this
# script's own location so it works from any directory. The assertions live in
# tools/generate/bin/smoke.mjs, which is plain JavaScript with no dependency and
# no transform — it has to run straight after a deploy, on whatever Node is
# there, and it is imported by the UATs so its failure path can be tested
# against a fake origin rather than by breaking a real deploy.
#
# Usage:
#   bin/smoke                                       # everything that can run, runs
#   bin/smoke --site-key site_a3f9c1d2e4b5             # the /site/<key>/ grammar too
#   bin/smoke --origin https://staging.example --site-key site_a3f9c1d2e4b5
#
# `--control-origin` defaults to app.<host> of the origin, so the REQ-147 gate is
# checked without being told where it is. The published-channel checks that need
# only a published ROOT address the apex when one is published, so they run with
# no argument too ([[BUG-136]]) — `--site-key` remains for the two that assert
# the /site/<key>/ grammar itself, because a key is 128 random bits and this
# script takes no dependency that could ask D1 for one.
#
# Exits 0 when every check passes, 1 naming the ones that did not.

set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$here/.." && pwd)"

exec node "$repo_root/tools/generate/bin/smoke.mjs" "$@"
