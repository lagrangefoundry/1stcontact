#!/usr/bin/env bash
#
# `bin/dev` — start the local dev environment, stop it, and reclaim what stopping
# it could not reach ([[REQ-319]]).
#
# A LAUNCHER, EXACTLY LIKE `bin/1c` AND `bin/repro-console`. The three verbs are
# `1c dev up`, `1c dev down` and `1c dev reap`, and this script's whole job is to
# spell them the way they are asked for. They are a `1c` subcommand rather than a
# script of their own because all three read ONE table — `1c ps`'s survey of the
# dev port band — and `down` and `reap` are that table's other readers. Written
# here instead, they would have to parse the output of a command they could have
# called, which is the arrangement `ps.ts` exists to avoid.
#
#   bin/dev up              build/deploy the local target, then start filing, the
#                           builder, the public site and access-sim, recording a
#                           pidfile per service under storage/tmp/dev
#   bin/dev down            SIGTERM what the pidfiles name, then VERIFY the ports
#                           are free; exits non-zero when one is still answering
#   bin/dev reap --dry-run   list every listener of this repo's that no pidfile
#                           claims, and kill nothing
#   bin/dev reap            kill them: SIGTERM, then SIGKILL what is still there,
#                           reporting what it could not kill
#
# `1c ps` is the view all three are built on: what is running, with its pid, its
# port and the directory it was started from.
#
# Exit codes: 0 success; 6 the environment did not reach the asked-for state (a
# service that would not start, a port that would not free, a process that would
# not die).
#
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$here/.." && pwd)"

exec node "$repo_root/tools/generate/bin/1c.mjs" dev "$@"
