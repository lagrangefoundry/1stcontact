---
import { renderMarkdown } from '../markdown'
import { assertSafeUrl } from '../safety'
import { resolveContainerWidth, resolveStep, SPACING_STEPS } from '../dials'
import { resolveTextStyle, resolveSurfaceGradient, type TextRun, type TextRunGradient } from '../text-style'

interface Props {
  variant?: string
  dials?: Record<string, string>
  content: {
    heading?: TextRun
    body: string
    bodyStyle?: TextRun
    cta?: TextRun
    panelGradient?: TextRunGradient
  }
}

const { variant = 'prose', dials = {}, content } = Astro.props as Props
const align = dials.align ?? 'left'
const surface = dials.surface ?? 'default'
// Vertical spacing (REQ-58 absolute-or-overlay) — a named step OR an absolute px
// length, resolved to an inline `--fc-pt`/`--fc-pb` var.
const padTopCss = resolveStep(dials.spacingTop, SPACING_STEPS, 'lg')
const padBottomCss = resolveStep(dials.spacingBottom, SPACING_STEPS, 'lg')
const textAlign = dials.textAlign ?? 'left'
// Constrained content column (REQ-45 capability, REQ-55 scale + literal). Resolves
// to a max-width length applied via `--fc-content-width`, or null (fills frame).
const contentWidthCss = resolveContainerWidth(dials.contentWidth)
// Heading letter-case (REQ-36) — `upper` uppercases at render; DOM text literal.
const headingCase = dials.headingCase ?? 'normal'
// Heading text-alignment (REQ-36), independent of the block/body align.
const headingAlign = dials.headingAlign ?? 'left'
// Contained-panel treatment (REQ-36). A gradient panel fill (REQ-62) supersedes
// the solid `panel` dial: it forces the `gradient` panel class (so the inner gets
// the padded/rounded/inset panel box) and paints its background-image inline.
const panelGradientCss = content.panelGradient ? resolveSurfaceGradient(content.panelGradient) : ''
const panel = panelGradientCss ? 'gradient' : (dials.panel ?? 'none')
// Body list marker (REQ-36) — `check` = accent ✓; `bullet` (default).
const listMarker = dials.listMarker ?? 'bullet'
// CTA corner shape (REQ-36).
const ctaShape = dials.ctaShape ?? 'round'
// Panel vertical padding + corner shape (REQ-36).
// Panel padding (REQ-58 absolute-or-overlay) — named step OR absolute px.
const PANEL_PAD_STEPS = { md: 'var(--space-12)', lg: 'var(--space-16)', xl: 'var(--space-24)' }
const panelPadCss = resolveStep(dials.panelPad, PANEL_PAD_STEPS, 'md')
const panelCorner = dials.panelCorner ?? 'rounded'
const { heading, cta } = content
const bodyHtml = await renderMarkdown(content.body)

// REQ-50 — styled runs → inline `style`. `bodyStyle` is a style-only run whose
// resolved declaration is applied to the prose container so the whole markdown
// block inherits its family/size/weight/colour/leading.
const headingStyle = resolveTextStyle(heading)
const bodyStyle = resolveTextStyle(content.bodyStyle)
const ctaStyle = resolveTextStyle(cta)
---

<section
  class:list={[
    'text-block',
    `variant-${variant}`,
    `align-${align}`,
    `surface-${surface}`,
    `text-align-${textAlign}`,
    { 'has-content-width': contentWidthCss !== null },
    `panel-${panel}`,
    `panel-corner-${panelCorner}`,
    `list-marker-${listMarker}`,
  ]}
  style={[contentWidthCss && `--fc-content-width: ${contentWidthCss}`, `--fc-pt: ${padTopCss}`, `--fc-pb: ${padBottomCss}`].filter(Boolean).join('; ')}
>
  <div class="text-block__inner" style={[panelGradientCss, `--fc-panel-pad: ${panelPadCss}`].filter(Boolean).join('; ') || undefined}>
    {heading?.text && <h2 class:list={['text-block__heading', `case-${headingCase}`, `halign-${headingAlign}`]} style={headingStyle}>{heading.text}</h2>}
    <div class="text-block__body" style={bodyStyle} set:html={bodyHtml} />
    {cta?.label && cta.href && <a class:list={['text-block__cta', `cta-${ctaShape}`]} style={ctaStyle} href={assertSafeUrl(cta.href, 'text-block cta href')}>{cta.label}</a>}
  </div>
</section>

<style>
  /* Vertical spacing resolves to inline `--fc-pt`/`--fc-pb` (a step token OR an
     absolute px), replacing the former per-step classes (REQ-58). */
  .text-block { background: var(--color-bg); color: var(--color-text); padding-top: var(--fc-pt); padding-bottom: var(--fc-pb); }
  .text-block.surface-subtle { background: var(--color-surface-subtle); }
  .text-block.surface-inverse { background: var(--color-surface-inverse); color: var(--color-bg); }
  .text-block.surface-accent { background: var(--color-accent); color: var(--color-bg); }

  /* Container width is set by the variant, not a dial. Both variants default to
     the standard content container (matching services-grid geometry: full
     container width, margin-inline:auto = left-pinned at the gutter on desktop).
     A narrower reading measure is opt-in via the `contentWidth` child-cap dial
     below — never the base, so a plain prose block is not off-centre and narrow. */
  .text-block__inner {
    margin-inline: auto;
    padding-inline: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .text-block.variant-prose .text-block__inner { max-width: var(--container-6xl); }
  .text-block.variant-landing .text-block__inner { max-width: var(--container-6xl); }

  .text-block.align-center .text-block__inner { align-items: center; }
  .text-block.text-align-center .text-block__inner { text-align: center; }

  /* Contained-panel treatment (REQ-36) — the inner content column becomes a
     padded, rounded card in a palette role, floating on the band background. */
  .text-block.panel-subtle .text-block__inner,
  .text-block.panel-inverse .text-block__inner,
  .text-block.panel-secondary .text-block__inner,
  .text-block.panel-accent .text-block__inner,
  .text-block.panel-gradient .text-block__inner {
    padding: var(--fc-panel-pad, var(--space-12)) var(--space-8);
    border-radius: var(--radius-lg);
  }
  .text-block.panel-corner-square .text-block__inner { border-radius: 0; }
  /* Contained panel: the constrained width caps the panel (inner) itself (REQ-55). */
  .text-block:not(.panel-none).has-content-width .text-block__inner { max-width: var(--fc-content-width); }
  .text-block.panel-subtle .text-block__inner { background: var(--color-surface-subtle); }
  .text-block.panel-inverse .text-block__inner { background: var(--color-surface-inverse); color: var(--color-bg); }
  .text-block.panel-secondary .text-block__inner { background: var(--color-secondary); color: var(--color-bg); }
  .text-block.panel-accent .text-block__inner { background: var(--color-accent); color: var(--color-bg); }

  /* Checklist markers (REQ-36) — replace the bullet with an accent ✓. */
  .text-block.list-marker-check .text-block__body ul { list-style: none; padding-left: 0; display: inline-block; text-align: left; }
  .text-block.list-marker-check .text-block__body li { position: relative; padding-left: 1.6em; }
  .text-block.list-marker-check .text-block__body li::before {
    content: "\f00c";
    font-family: 'IconFont';
    position: absolute;
    left: 0;
    top: 0.15em;
    font-size: 0.85em;
    color: var(--color-accent);
  }

  /* Constrained content column (REQ-45 capability, REQ-55 mechanism): caps the
     content children to `--fc-content-width` (a named-step token or a literal). */
  .text-block.has-content-width .text-block__inner > * { max-width: var(--fc-content-width); width: 100%; }

  /* REQ-50 — base slot styling supplies the defaults an omitting run inherits;
     any axis the styled run sets overrides via inline `style`. */
  .text-block__heading {
    margin: 0;
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    font-size: var(--font-size-3xl);
  }
  .text-block__heading.case-upper { text-transform: uppercase; }
  .text-block__heading.halign-left { text-align: left; }
  .text-block__heading.halign-center { text-align: center; }

  /* Prose body: base size + leading; a `bodyStyle` run overrides via inline
     `style`, and its inner element rules (headings, links, quotes) stay. */
  .text-block__body { font-size: var(--font-size-base); line-height: var(--line-height-relaxed); }
  .text-block__body :global(h1),
  .text-block__body :global(h2),
  .text-block__body :global(h3) {
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-tight);
  }
  .text-block__body :global(a) { color: var(--color-primary); }
  .text-block__body :global(img) { max-width: 100%; height: auto; border-radius: var(--radius-md); }
  .text-block__body :global(blockquote) {
    margin: 0;
    padding-inline-start: var(--space-4);
    border-inline-start: 3px solid var(--color-border);
    color: var(--color-muted);
  }
  .text-block__body :global(pre) {
    overflow-x: auto;
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-surface-subtle);
  }

  /* Optional CTA button (REQ-36). */
  .text-block__cta {
    display: inline-block;
    align-self: flex-start;
    margin-top: var(--space-6);
    background: var(--color-accent);
    color: var(--color-bg);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }
  .text-block.text-align-center .text-block__cta { align-self: center; }
  .text-block__cta.cta-square { border-radius: 0; }
</style>
