---
import { renderMarkdown } from '../markdown'

interface Props {
  variant?: string
  dials?: Record<string, string>
  content: {
    heading?: string
    body: string
  }
}

const { variant = 'prose', dials = {}, content } = Astro.props as Props
const size = dials.size ?? 'md'
const align = dials.align ?? 'left'
const surface = dials.surface ?? 'default'
const spacingTop = dials.spacingTop ?? 'lg'
const spacingBottom = dials.spacingBottom ?? 'lg'
const textAlign = dials.textAlign ?? 'left'
// Constrained content column (REQ-45): `default` leaves the variant width; the
// `align` dial governs where a capped column sits (left gutter / centred).
const contentWidth = dials.contentWidth ?? 'default'

// Heading colour treatment (REQ-36) — `plain` (default) inherits the band text
// colour; `accent`/`gold` colour the heading (the joyfulculinary gold section
// headings). A section that omits the dial is unchanged.
const headingTreatment = dials.headingTreatment ?? 'plain'
// Heading letter-case (REQ-36) — `upper` uppercases at render; DOM text literal.
const headingCase = dials.headingCase ?? 'normal'
// Heading typography (REQ-36) — weight/size/alignment independent of the body:
// `bold`/`md`/`left` preserve the prior heading, so an omitting section is
// unchanged. Lighter weights + a larger size reach the reference's extralight
// section headings; `headingAlign` centres the heading over a left-aligned body.
const headingWeight = dials.headingWeight ?? 'bold'
const headingSize = dials.headingSize ?? 'md'
const headingAlign = dials.headingAlign ?? 'left'
// Body line-height (REQ-36) — `relaxed` (default) preserves the prior leading;
// tighter steps match a denser reference body and collapse vertical drift.
const leading = dials.leading ?? 'relaxed'
const { heading } = content
const bodyHtml = await renderMarkdown(content.body)
---

<section
  class:list={[
    'text-block',
    `variant-${variant}`,
    `size-${size}`,
    `align-${align}`,
    `surface-${surface}`,
    `text-align-${textAlign}`,
    `content-width-${contentWidth}`,
    `leading-${leading}`,
    `spacing-top-${spacingTop}`,
    `spacing-bottom-${spacingBottom}`,
  ]}
>
  <div class="text-block__inner">
    {heading && <h2 class:list={['text-block__heading', `treatment-${headingTreatment}`, `case-${headingCase}`, `hw-${headingWeight}`, `hs-${headingSize}`, `halign-${headingAlign}`]}>{heading}</h2>}
    <div class="text-block__body" set:html={bodyHtml} />
  </div>
</section>

<style>
  .text-block { background: var(--color-bg); color: var(--color-text); }
  .text-block.surface-subtle { background: var(--color-surface-subtle); }
  .text-block.surface-inverse { background: var(--color-surface-inverse); color: var(--color-bg); }
  .text-block.surface-accent { background: var(--color-accent); color: var(--color-bg); }

  .text-block.spacing-top-none { padding-top: var(--space-0); }
  .text-block.spacing-top-sm { padding-top: var(--space-4); }
  .text-block.spacing-top-md { padding-top: var(--space-8); }
  .text-block.spacing-top-lg { padding-top: var(--space-16); }
  .text-block.spacing-top-xl { padding-top: var(--space-24); }
  .text-block.spacing-bottom-none { padding-bottom: var(--space-0); }
  .text-block.spacing-bottom-sm { padding-bottom: var(--space-4); }
  .text-block.spacing-bottom-md { padding-bottom: var(--space-8); }
  .text-block.spacing-bottom-lg { padding-bottom: var(--space-16); }
  .text-block.spacing-bottom-xl { padding-bottom: var(--space-24); }

  /* Container width is set by the variant, not a dial. */
  .text-block__inner {
    margin-inline: auto;
    padding-inline: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .text-block.variant-prose .text-block__inner { max-width: var(--container-narrow); }
  .text-block.variant-landing .text-block__inner { max-width: var(--container-default); }

  .text-block.align-center .text-block__inner { align-items: center; }
  .text-block.text-align-center .text-block__inner { text-align: center; }

  /* Constrained content column (REQ-45): the inner stays a full-width frame
     (its variant width) while these cap the *content* to a narrower measure.
     The `align` dial then places it — `left` (default) leaves the capped items
     at the flex cross-start, pinned to the frame's left gutter (the header/hero
     content edge); `align-center` (align-items: center, above) centres them.
     `content-width-default` sets no cap, so the content fills the frame and a
     section that omits the dial is unchanged. Token-backed widths, no raw CSS. */
  .text-block.content-width-narrow .text-block__inner > * { max-width: var(--container-narrow); width: 100%; }
  .text-block.content-width-readable .text-block__inner > * { max-width: var(--container-readable); width: 100%; }
  .text-block.content-width-wide .text-block__inner > * { max-width: var(--container-wide); width: 100%; }

  /* Heading colour treatment (REQ-36), independent of the surface text colour —
     the same treatment vocabulary as the hero heading. `plain` inherits the band
     colour (no rule); `accent` fills solid gold; `gold` is the metallic-gold
     gradient clipped to the text. */
  .text-block__heading.case-upper { text-transform: uppercase; }
  .text-block__heading.treatment-accent { color: var(--color-accent); }
  .text-block__heading.treatment-gold {
    background-image: linear-gradient(180deg, #f7e4a8 0%, var(--color-accent) 48%, #b07d24 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .text-block__heading {
    margin: 0;
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    font-size: var(--font-size-3xl);
  }
  /* Heading font-weight (REQ-36) — `bold` is the base above; the lighter steps
     reach the reference's extralight/light section headings. */
  .text-block__heading.hw-extralight { font-weight: var(--font-weight-extralight); }
  .text-block__heading.hw-light { font-weight: var(--font-weight-light); }
  .text-block__heading.hw-regular { font-weight: var(--font-weight-regular); }
  .text-block__heading.hw-medium { font-weight: var(--font-weight-medium); }
  .text-block__heading.hw-semibold { font-weight: var(--font-weight-semibold); }
  /* Heading font-size step (REQ-36) — `hs-md` = the `3xl` base above; the rest
     step the heading independently of the body `size` dial. */
  .text-block__heading.hs-sm { font-size: var(--font-size-2xl); }
  .text-block__heading.hs-lg { font-size: var(--font-size-4xl); }
  .text-block__heading.hs-xl { font-size: var(--font-size-5xl); }
  /* Heading text-alignment (REQ-36) — independent of the block/body align, so a
     centred heading can sit over a left-aligned body (the reference). */
  .text-block__heading.halign-left { text-align: left; }
  .text-block__heading.halign-center { text-align: center; }

  /* The body type scale follows the size dial (DOC-7 §4.1). */
  .text-block__body { line-height: var(--line-height-relaxed); }
  /* Body line-height (REQ-36) — `relaxed` is the base above; tighter steps match
     a denser reference body and collapse the drift a loose default injects. */
  .text-block.leading-tight .text-block__body { line-height: var(--line-height-tight); }
  .text-block.leading-snug .text-block__body { line-height: var(--line-height-snug); }
  .text-block.leading-normal .text-block__body { line-height: var(--line-height-normal); }
  .text-block.size-sm .text-block__body { font-size: var(--font-size-sm); }
  .text-block.size-md .text-block__body { font-size: var(--font-size-base); }
  .text-block.size-lg .text-block__body { font-size: var(--font-size-lg); }

  .text-block__body :global(h1),
  .text-block__body :global(h2),
  .text-block__body :global(h3) {
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-tight);
  }
  .text-block__body :global(a) { color: var(--color-primary); }
  .text-block__body :global(img) { max-width: 100%; height: auto; border-radius: var(--radius-md); }
  .text-block__body :global(blockquote) {
    margin: 0;
    padding-inline-start: var(--space-4);
    border-inline-start: 3px solid var(--color-border);
    color: var(--color-muted);
  }
  .text-block__body :global(pre) {
    overflow-x: auto;
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-surface-subtle);
  }
</style>
