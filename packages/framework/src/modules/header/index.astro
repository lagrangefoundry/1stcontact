---
import type { AssetRef, NavEntry } from '@1stcontact/site-schema'
import { navHref } from '../nav'
import { assertSafeUrl } from '../safety'
import { gradientTextStyle, type GradientTreatment } from '../gradient'

interface Props {
  variant?: string
  dials?: Record<string, string>
  content: {
    logo?: AssetRef | string
    entries: NavEntry[]
    logoGradient?: GradientTreatment
  }
}

const { variant = 'top-nav', dials = {}, content } = Astro.props as Props
const surface = dials.surface ?? 'default'
const spacingTop = dials.spacingTop ?? 'md'
const spacingBottom = dials.spacingBottom ?? 'md'
// Horizontal placement of the header content (REQ-29).
const align = dials.align ?? 'left'
// Wordmark font-family + colour treatment (REQ-24), applied to a text logo only.
const logoFont = dials.logoFont ?? 'heading'
const logoTreatment = dials.logoTreatment ?? 'plain'
// Logo size, independent of font/treatment; `xl` reads at display scale. Sizes
// the wordmark font and (REQ-36) an image logo's height.
const logoSize = dials.logoSize ?? 'md'
// Logo backdrop (REQ-36) — `card` floats the logo on a padded rounded shadowed
// plate; `none` (default) renders it bare.
const logoCard = dials.logoCard ?? 'none'
// Wordmark letter-spacing (REQ-45): `normal` leaves the wordmark untracked.
const tracking = dials.tracking ?? 'normal'
const entries = content.entries ?? []
const logo = content.logo
const logoIsImage = typeof logo === 'object' && logo !== null
// Structured gradient wordmark (REQ-32): the framework computes the clipped
// gradient from the `logoGradient` field when the treatment dial selects it.
const wordmarkGradient =
  logoTreatment === 'gradient' ? gradientTextStyle(content.logoGradient) : undefined
---

<header
  class:list={[
    'header',
    `variant-${variant}`,
    `surface-${surface}`,
    `align-${align}`,
    `spacing-top-${spacingTop}`,
    `spacing-bottom-${spacingBottom}`,
  ]}
>
  <div class="header__inner">
    <a class:list={['header__logo', `logo-size-${logoSize}`, `logo-card-${logoCard}`]} href="/">
      {logoIsImage ? (
        <img src={assertSafeUrl((logo as AssetRef).src, 'header logo src')} alt={(logo as AssetRef).alt} />
      ) : (
        <span
          class:list={[
            'header__wordmark',
            `header__wordmark--font-${logoFont}`,
            `header__wordmark--${logoTreatment}`,
            `header__wordmark--size-${logoSize}`,
            `header__wordmark--tracking-${tracking}`,
          ]}
          style={wordmarkGradient}
        >{logo}</span>
      )}
    </a>

    <button
      class="header__toggle"
      type="button"
      data-nav-toggle
      aria-label="Toggle navigation"
      aria-expanded="false"
    >
      <span class="header__toggle-bar"></span>
      <span class="header__toggle-bar"></span>
      <span class="header__toggle-bar"></span>
    </button>

    <nav class="header__nav" aria-label="Primary">
      {entries.map((entry) => <a href={navHref(entry.target)}>{entry.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .header {
    background: var(--color-bg);
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
  }
  .header.surface-subtle { background: var(--color-surface-subtle); }
  .header.surface-inverse { background: var(--color-surface-inverse); color: var(--color-bg); }
  .header.surface-accent { background: var(--color-accent); color: var(--color-bg); }

  /* Overlay variant (REQ-25): transparent chrome the render pipeline floats over
     the following section's band so the two share one image band. Declared after
     the surface rules so its transparent fill wins the specificity tie — a
     `surface` dial still selects the text colour (e.g. `inverse` for light text
     over a dark image) while the fill stays clear. */
  .header.variant-overlay { background: transparent; border-bottom: none; }

  .header.spacing-top-none { padding-top: var(--space-0); }
  .header.spacing-top-sm { padding-top: var(--space-2); }
  .header.spacing-top-md { padding-top: var(--space-4); }
  .header.spacing-top-lg { padding-top: var(--space-8); }
  /* `xl` gives a hero-scale overlay wordmark generous top breathing room — the
     reference floats the wordmark well below the top edge, not flush to it. */
  .header.spacing-top-xl { padding-top: var(--space-16); }
  .header.spacing-bottom-none { padding-bottom: var(--space-0); }
  .header.spacing-bottom-sm { padding-bottom: var(--space-2); }
  .header.spacing-bottom-md { padding-bottom: var(--space-4); }
  .header.spacing-bottom-lg { padding-bottom: var(--space-8); }
  .header.spacing-bottom-xl { padding-bottom: var(--space-12); }

  .header__inner {
    max-width: var(--container-default);
    margin-inline: auto;
    padding-inline: var(--space-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  /* Content alignment (REQ-29): `center` groups the wordmark/nav centrally
     rather than spreading them edge-to-edge. */
  .header.align-center .header__inner { justify-content: center; }
  .header__logo { font-weight: var(--font-weight-bold); color: inherit; text-decoration: none; }
  .header__logo img { display: block; height: var(--space-8); width: auto; }
  /* Image-logo height responds to `logoSize` (REQ-36) — `md` is the prior 2rem;
     `lg`/`xl` scale an image logo up (the reference logo is ~3rem tall). */
  .header__logo.logo-size-sm img { height: var(--space-6); }
  .header__logo.logo-size-lg img { height: var(--space-12); }
  .header__logo.logo-size-xl img { height: var(--space-16); }
  /* Logo card backdrop (REQ-36) — a padded, rounded, shadowed plate in the
     background colour so an image logo stays legible over photography. */
  .header__logo.logo-card-card {
    background: var(--color-bg);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }

  /* Wordmark font-family selection (REQ-24). Default heading family; `display`
     picks the site's bespoke display face, `body` the body family. */
  .header__wordmark { font-family: var(--font-family-heading); }
  .header__wordmark--font-heading { font-family: var(--font-family-heading); }
  .header__wordmark--font-body { font-family: var(--font-family-body); }
  .header__wordmark--font-display {
    font-family: var(--font-family-display);
    /* Tight tracking for a large display wordmark — a positive value spreads the
       glyphs unnaturally at hero scale. */
    letter-spacing: -0.025em;
    /* Render the display face's own semibold rather than inheriting the header
       logo's `bold` (700). When the face ships only a 600 weight, forcing 700
       makes the browser synthesise faux-bold — a heavier, distorted wordmark. */
    font-weight: var(--font-weight-semibold);
  }

  /* Wordmark size (independent of font/treatment). Default `md` preserves the
     prior 2xl scale; `xl` reads at display scale for a hero wordmark. */
  .header__wordmark--size-sm { font-size: var(--font-size-xl); }
  .header__wordmark--size-md { font-size: var(--font-size-2xl); }
  .header__wordmark--size-lg { font-size: var(--font-size-4xl); }
  .header__wordmark--size-xl { font-size: clamp(var(--font-size-4xl), 6vw, var(--font-size-5xl)); }

  /* Wordmark letter-spacing (REQ-45), independent of font/size/treatment. Only
     the tighter steps emit an override; `normal` sets nothing so a display
     wordmark keeps the font face's built-in tracking (default fallback
     unchanged). Declared after the font rules so an explicit tracking dial wins
     over that built-in tracking. Token-backed — no raw em value reaches the
     page. */
  .header__wordmark--tracking-tight { letter-spacing: var(--tracking-tight); }
  .header__wordmark--tracking-tighter { letter-spacing: var(--tracking-tighter); }

  /* Gold wordmark treatment (REQ-24): a metallic-gold gradient clipped to the
     glyphs, keyed to the site accent. `plain` inherits the header text colour. */
  .header__wordmark--gold {
    background-image: linear-gradient(
      180deg,
      #f7e4a8 0%,
      var(--color-accent) 48%,
      #b07d24 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .header__nav { display: flex; gap: var(--space-6); }
  .header__nav a { color: inherit; text-decoration: none; font-weight: var(--font-weight-medium); }

  /* Hamburger toggle: hidden on desktop, shown below the md breakpoint. */
  .header__toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: var(--space-2);
  }
  .header__toggle-bar { display: block; width: 22px; height: 2px; background: currentColor; }

  @media (max-width: 768px) {
    .header__toggle { display: flex; }
    .header__nav { display: none; }
  }
</style>
