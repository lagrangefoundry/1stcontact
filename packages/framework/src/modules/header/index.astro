---
import type { AssetRef, NavEntry } from '@1stcontact/site-schema'
import { navHref } from '../nav'
import { assertSafeUrl } from '../safety'
import { positionVars } from '../layer'
import { responsiveStepVars } from '../dials'
import { resolveTextStyle, type TextRun } from '../text-style'

interface Props {
  variant?: string
  dials?: Record<string, string>
  content: {
    logo?: AssetRef
    wordmark?: TextRun
    entries: NavEntry[]
    navStyle?: TextRun
  }
}

const { variant = 'top-nav', dials = {}, content } = Astro.props as Props
const surface = dials.surface ?? 'default'
// Vertical spacing (REQ-58 absolute-or-overlay) — step OR absolute px.
const HEADER_SPACING_STEPS = { none: 'var(--space-0)', sm: 'var(--space-2)', md: 'var(--space-4)', lg: 'var(--space-8)', xl: 'var(--space-16)', '2xl': 'var(--space-24)', '3xl': 'var(--space-32)' }
const padTopVars = responsiveStepVars('pt', dials.spacingTop, HEADER_SPACING_STEPS, 'md')
const padBottomVars = responsiveStepVars('pb', dials.spacingBottom, HEADER_SPACING_STEPS, 'md')
// Horizontal placement of the header content (REQ-29).
const align = dials.align ?? 'left'
// Image-logo height (REQ-36).
// Logo size (REQ-58 absolute-or-overlay) — named step OR absolute px.
const LOGO_STEPS = { sm: 'var(--space-6)', md: 'var(--space-8)', lg: 'var(--space-12)', xl: 'var(--space-16)' }
const logoSizeVars = responsiveStepVars('logo', dials.logoSize, LOGO_STEPS, 'md')
// Logo backdrop (REQ-36) — `card`/`shadow`/`frame`; `none` (default) bare.
const logoCard = dials.logoCard ?? 'none'
// REQ-61 — configurable nav collapse: the breakpoint below which the nav folds to
// a hamburger (`sm`/`md`/`lg`/`xl`), or `none` to never collapse. Media-query
// thresholds cannot be CSS custom properties, so this is a named-breakpoint
// overlay (a mode), not an absolute px — the one length the absolute-value mandate
// can't express. Default `md`, matching the former hardcoded 768px.
const navCollapse = dials.navCollapse ?? 'md'
const entries = content.entries ?? []
const { logo, wordmark } = content

// REQ-50 — the wordmark's intrinsic style (incl. the former gold/gradient
// treatments via `color`/`gradient`) and the shared nav-link style.
const wordmarkStyle = resolveTextStyle(wordmark)
const navStyle = resolveTextStyle(content.navStyle)

// REQ-52 — a text wordmark carrying a `position` is lifted out of the flow row
// and placed by the framework's `--fc-*` coordinate model within the band. In an
// `overlay` header the chrome spans the full band, so the wordmark shares the
// hero's coordinate space (e.g. drop the wordmark to the lower-left while the nav
// stays at the top-right). No position → the flow-row wordmark, exactly as before.
const wordmarkPositioned = !logo && !!wordmark?.position
// Join the run's resolved style (no trailing `;`) to the position vars with a
// separating `;`, else the first `--fc-*` fuses onto the last declaration and is
// dropped as invalid.
const wordmarkPosStyle = wordmark?.position
  ? wordmarkStyle
    ? `${wordmarkStyle.replace(/\s*;?\s*$/, '')}; ${positionVars(wordmark.position)}`
    : positionVars(wordmark.position)
  : ''
---

<header
  class:list={[
    'header',
    `variant-${variant}`,
    `surface-${surface}`,
    `align-${align}`,
    `nav-collapse-${navCollapse}`,
  ]}
  style={[padTopVars, padBottomVars].join('; ')}
>
  {wordmarkPositioned && wordmark?.text && (
    <a class="header__logo header__logo--positioned" href="/" style={wordmarkPosStyle}>
      <span class="header__wordmark" style={wordmarkStyle}>{wordmark.text}</span>
    </a>
  )}
  <div class="header__inner">
    {!wordmarkPositioned && (
      <a class:list={['header__logo', `logo-card-${logoCard}`]} href="/" style={logoSizeVars}>
        {logo ? (
          <img src={assertSafeUrl(logo.src, 'header logo src')} alt={logo.alt} />
        ) : (
          wordmark?.text && <span class="header__wordmark" style={wordmarkStyle}>{wordmark.text}</span>
        )}
      </a>
    )}

    <button
      class="header__toggle"
      type="button"
      data-nav-toggle
      aria-label="Toggle navigation"
      aria-expanded="false"
    >
      <span class="header__toggle-bar"></span>
      <span class="header__toggle-bar"></span>
      <span class="header__toggle-bar"></span>
    </button>

    <nav class="header__nav" aria-label="Primary">
      {entries.map((entry) => <a href={navHref(entry.target)} style={navStyle}>{entry.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .header {
    background: var(--color-bg);
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
    padding-top: var(--fc-pt);
    padding-bottom: var(--fc-pb);
  }
  /* REQ-61 — per-breakpoint spacing override chain (see ./breakpoints). */
  @media (min-width: 640px) { .header { padding-top: var(--fc-pt-sm, var(--fc-pt)); padding-bottom: var(--fc-pb-sm, var(--fc-pb)); } }
  @media (min-width: 768px) { .header { padding-top: var(--fc-pt-md, var(--fc-pt-sm, var(--fc-pt))); padding-bottom: var(--fc-pb-md, var(--fc-pb-sm, var(--fc-pb))); } }
  @media (min-width: 1024px) { .header { padding-top: var(--fc-pt-lg, var(--fc-pt-md, var(--fc-pt-sm, var(--fc-pt)))); padding-bottom: var(--fc-pb-lg, var(--fc-pb-md, var(--fc-pb-sm, var(--fc-pb)))); } }
  @media (min-width: 1280px) { .header { padding-top: var(--fc-pt-xl, var(--fc-pt-lg, var(--fc-pt-md, var(--fc-pt-sm, var(--fc-pt))))); padding-bottom: var(--fc-pb-xl, var(--fc-pb-lg, var(--fc-pb-md, var(--fc-pb-sm, var(--fc-pb))))); } }
  .header.surface-subtle { background: var(--color-surface-subtle); }
  .header.surface-inverse { background: var(--color-surface-inverse); color: var(--color-bg); }
  .header.surface-accent { background: var(--color-accent); color: var(--color-bg); }

  /* Overlay variant (REQ-25): transparent chrome the render pipeline floats over
     the following section's band. A `surface` dial still selects the text colour
     while the fill stays clear. */
  .header.variant-overlay { background: transparent; border-bottom: none; }


  .header__inner {
    max-width: var(--container-6xl);
    margin-inline: auto;
    padding-inline: var(--space-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  /* Content alignment (REQ-29): `center` groups the wordmark/nav centrally. */
  .header.align-center .header__inner { justify-content: center; }
  .header__logo { font-weight: var(--font-weight-bold); color: inherit; text-decoration: none; }
  /* Positioned wordmark (REQ-52): in an overlay header the chrome spans the full
     band, so the wordmark places against it by the framework `--fc-*` model —
     the same coordinate space as the hero's own objects. Scoped to `overlay` so
     a `top-nav` header (its own band, no chrome) is never absolutely placed. */
  .header.variant-overlay .header__logo--positioned {
    position: absolute;
    left: var(--fc-x, 0%);
    top: var(--fc-y, 0%);
    width: var(--fc-w, auto);
    z-index: var(--fc-z, 3);
    transform: rotate(var(--fc-rotate, 0deg));
  }
  .header__logo img { display: block; height: var(--fc-logo, var(--space-8)); width: auto; }
  /* REQ-61 — per-breakpoint logo-height override chain (see ./breakpoints). */
  @media (min-width: 640px) { .header__logo img { height: var(--fc-logo-sm, var(--fc-logo)); } }
  @media (min-width: 768px) { .header__logo img { height: var(--fc-logo-md, var(--fc-logo-sm, var(--fc-logo))); } }
  @media (min-width: 1024px) { .header__logo img { height: var(--fc-logo-lg, var(--fc-logo-md, var(--fc-logo-sm, var(--fc-logo)))); } }
  @media (min-width: 1280px) { .header__logo img { height: var(--fc-logo-xl, var(--fc-logo-lg, var(--fc-logo-md, var(--fc-logo-sm, var(--fc-logo))))); } }
  /* Image-logo height responds to `logoSize` (REQ-36). */
  /* Logo card backdrop (REQ-36) — a padded, rounded, shadowed plate. */
  .header__logo.logo-card-card {
    background: var(--color-bg);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }
  /* `shadow` — a drop-shadow on the logo glyphs (no plate). */
  .header__logo.logo-card-shadow img { filter: drop-shadow(0 2px 5px rgba(0, 0, 0, 0.55)); }
  /* `frame` — a wide translucent plate with a thin light border. */
  .header__logo.logo-card-frame {
    padding: var(--space-4) var(--space-12);
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: rgba(255, 255, 255, 0.07);
  }
  .header__logo.logo-card-frame img { filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.45)); }

  /* REQ-50 — the wordmark's family/size/weight/colour/tracking/gradient come
     from the `wordmark` run's inline `style`; the base keeps the heading family
     as the default an omitting run inherits. */
  .header__wordmark { font-family: var(--font-family-heading); font-size: var(--font-size-2xl); }

  .header__nav { display: flex; gap: var(--space-6); }
  /* Nav-link size/weight/colour come from the shared `navStyle` run; the base
     supplies the default weight an omitting run inherits. */
  .header__nav a { color: inherit; text-decoration: none; font-weight: var(--font-weight-medium); }

  /* Hamburger toggle: hidden on desktop, shown below the md breakpoint. */
  .header__toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: var(--space-2);
  }
  .header__toggle-bar { display: block; width: 22px; height: 2px; background: currentColor; }

  /* REQ-61 — collapse to a hamburger below the configured breakpoint. The
     `nav-collapse-<bp>` class (default md) selects the threshold; `nav-collapse-none`
     matches no rule, so the nav never collapses. Media-query thresholds can't read
     a custom property, so the breakpoint is a named overlay, not an absolute px. */
  @media (max-width: 640px) { .header.nav-collapse-sm .header__toggle { display: flex; } .header.nav-collapse-sm .header__nav { display: none; } }
  @media (max-width: 768px) { .header.nav-collapse-md .header__toggle { display: flex; } .header.nav-collapse-md .header__nav { display: none; } }
  @media (max-width: 1024px) { .header.nav-collapse-lg .header__toggle { display: flex; } .header.nav-collapse-lg .header__nav { display: none; } }
  @media (max-width: 1280px) { .header.nav-collapse-xl .header__toggle { display: flex; } .header.nav-collapse-xl .header__nav { display: none; } }
</style>
