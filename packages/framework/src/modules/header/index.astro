---
import type { AssetRef, NavEntry } from '@1stcontact/site-schema'
import { navHref } from '../nav'
import { assertSafeUrl } from '../safety'
import { resolveTextStyle, type TextRun } from '../text-style'

interface Props {
  variant?: string
  dials?: Record<string, string>
  content: {
    logo?: AssetRef
    wordmark?: TextRun
    entries: NavEntry[]
    navStyle?: TextRun
  }
}

const { variant = 'top-nav', dials = {}, content } = Astro.props as Props
const surface = dials.surface ?? 'default'
const spacingTop = dials.spacingTop ?? 'md'
const spacingBottom = dials.spacingBottom ?? 'md'
// Horizontal placement of the header content (REQ-29).
const align = dials.align ?? 'left'
// Image-logo height (REQ-36).
const logoSize = dials.logoSize ?? 'md'
// Logo backdrop (REQ-36) — `card`/`shadow`/`frame`; `none` (default) bare.
const logoCard = dials.logoCard ?? 'none'
const entries = content.entries ?? []
const { logo, wordmark } = content

// REQ-50 — the wordmark's intrinsic style (incl. the former gold/gradient
// treatments via `color`/`gradient`) and the shared nav-link style.
const wordmarkStyle = resolveTextStyle(wordmark)
const navStyle = resolveTextStyle(content.navStyle)
---

<header
  class:list={[
    'header',
    `variant-${variant}`,
    `surface-${surface}`,
    `align-${align}`,
    `spacing-top-${spacingTop}`,
    `spacing-bottom-${spacingBottom}`,
  ]}
>
  <div class="header__inner">
    <a class:list={['header__logo', `logo-size-${logoSize}`, `logo-card-${logoCard}`]} href="/">
      {logo ? (
        <img src={assertSafeUrl(logo.src, 'header logo src')} alt={logo.alt} />
      ) : (
        wordmark?.text && <span class="header__wordmark" style={wordmarkStyle}>{wordmark.text}</span>
      )}
    </a>

    <button
      class="header__toggle"
      type="button"
      data-nav-toggle
      aria-label="Toggle navigation"
      aria-expanded="false"
    >
      <span class="header__toggle-bar"></span>
      <span class="header__toggle-bar"></span>
      <span class="header__toggle-bar"></span>
    </button>

    <nav class="header__nav" aria-label="Primary">
      {entries.map((entry) => <a href={navHref(entry.target)} style={navStyle}>{entry.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .header {
    background: var(--color-bg);
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
  }
  .header.surface-subtle { background: var(--color-surface-subtle); }
  .header.surface-inverse { background: var(--color-surface-inverse); color: var(--color-bg); }
  .header.surface-accent { background: var(--color-accent); color: var(--color-bg); }

  /* Overlay variant (REQ-25): transparent chrome the render pipeline floats over
     the following section's band. A `surface` dial still selects the text colour
     while the fill stays clear. */
  .header.variant-overlay { background: transparent; border-bottom: none; }

  .header.spacing-top-none { padding-top: var(--space-0); }
  .header.spacing-top-sm { padding-top: var(--space-2); }
  .header.spacing-top-md { padding-top: var(--space-4); }
  .header.spacing-top-lg { padding-top: var(--space-8); }
  .header.spacing-top-xl { padding-top: var(--space-16); }
  .header.spacing-top-2xl { padding-top: var(--space-24); }
  .header.spacing-top-3xl { padding-top: var(--space-32); }
  .header.spacing-bottom-none { padding-bottom: var(--space-0); }
  .header.spacing-bottom-sm { padding-bottom: var(--space-2); }
  .header.spacing-bottom-md { padding-bottom: var(--space-4); }
  .header.spacing-bottom-lg { padding-bottom: var(--space-8); }
  .header.spacing-bottom-xl { padding-bottom: var(--space-12); }
  .header.spacing-bottom-2xl { padding-bottom: var(--space-24); }
  .header.spacing-bottom-3xl { padding-bottom: var(--space-32); }

  .header__inner {
    max-width: var(--container-default);
    margin-inline: auto;
    padding-inline: var(--space-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  /* Content alignment (REQ-29): `center` groups the wordmark/nav centrally. */
  .header.align-center .header__inner { justify-content: center; }
  .header__logo { font-weight: var(--font-weight-bold); color: inherit; text-decoration: none; }
  .header__logo img { display: block; height: var(--space-8); width: auto; }
  /* Image-logo height responds to `logoSize` (REQ-36). */
  .header__logo.logo-size-sm img { height: var(--space-6); }
  .header__logo.logo-size-lg img { height: var(--space-12); }
  .header__logo.logo-size-xl img { height: var(--space-16); }
  /* Logo card backdrop (REQ-36) — a padded, rounded, shadowed plate. */
  .header__logo.logo-card-card {
    background: var(--color-bg);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }
  /* `shadow` — a drop-shadow on the logo glyphs (no plate). */
  .header__logo.logo-card-shadow img { filter: drop-shadow(0 2px 5px rgba(0, 0, 0, 0.55)); }
  /* `frame` — a wide translucent plate with a thin light border. */
  .header__logo.logo-card-frame {
    padding: var(--space-4) var(--space-12);
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: rgba(255, 255, 255, 0.07);
  }
  .header__logo.logo-card-frame img { filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.45)); }

  /* REQ-50 — the wordmark's family/size/weight/colour/tracking/gradient come
     from the `wordmark` run's inline `style`; the base keeps the heading family
     as the default an omitting run inherits. */
  .header__wordmark { font-family: var(--font-family-heading); font-size: var(--font-size-2xl); }

  .header__nav { display: flex; gap: var(--space-6); }
  /* Nav-link size/weight/colour come from the shared `navStyle` run; the base
     supplies the default weight an omitting run inherits. */
  .header__nav a { color: inherit; text-decoration: none; font-weight: var(--font-weight-medium); }

  /* Hamburger toggle: hidden on desktop, shown below the md breakpoint. */
  .header__toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: var(--space-2);
  }
  .header__toggle-bar { display: block; width: 22px; height: 2px; background: currentColor; }

  @media (max-width: 768px) {
    .header__toggle { display: flex; }
    .header__nav { display: none; }
  }
</style>
