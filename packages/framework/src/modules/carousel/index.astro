---
import type { L1Node } from '@1stcontact/site-schema'
import { renderL1Fragment, type L1ControlElement } from '../../l1/render'

/**
 * `carousel` behavior (REQ-79, reframed REQ-85; layout-agnostic by construction
 * in REQ-96).
 *
 * The vetted core owns only behaviour: a pure CSS `scroll-snap` track (swipeable
 * with no JS) and an optional autoplay/loop wired by `client.js`. Each slide's
 * presentation is an **L1 subtree** mounted into the repeated `slide` slot, and
 * each pagination dot is an L1 `control` node naming an element the module
 * declares — so the module paints neither.
 *
 * Slot CSS is per-instance (geometry/colour vary by slide), so it is emitted as a
 * raw `<style>` in the body — self-closing in source, so `getModuleCss` (which
 * folds the static chrome `<style>` below) never double-emits it, while the
 * runtime `<style>` survives `renderToString`. `instanceId` namespaces the slot
 * classes so multiple carousels on a page never collide.
 */
interface Props {
  config?: Record<string, unknown>
  slots?: { slide?: L1Node[]; dots?: L1Node }
  instanceId?: string
  /**
   * REQ-116 — the edit channel. The module owns its behaviour, so it owns what
   * "my behaviour is off" looks like: with no `client.js` and no scrolling, the
   * track stacks so every slide's copy is on screen and clickable at once (the
   * settled-state rule below).
   */
  edit?: boolean
}

const { config = {}, slots = {}, instanceId = 'carousel', edit = false } = Astro.props as Props

const autoplay = config.autoplay === true
const loop = config.loop === true

// Isolation (REQ-85): malformed slot content must not break the page. Coerce to
// an array and drop any non-object subtree; the L1 renderer re-checks each value.
const slideNodes: L1Node[] = Array.isArray(slots.slide)
  ? slots.slide.filter((n): n is L1Node => !!n && typeof n === 'object')
  : []
const { htmls: slideHtmls, css: slideCss } = renderL1Fragment(slideNodes, `${instanceId}-slide`, undefined, {
  edit,
})

// REQ-96 — the module's half of the dot contract: one declared element per
// mounted slide, carrying the behavioural markers `client.js` reads. What a dot
// *looks* like is entirely the L1 node that names it.
const dotControls: Record<string, L1ControlElement> = {}
slideNodes.forEach((_, i) => {
  dotControls[`dot-${i}`] = {
    tag: 'span',
    attrs: {
      'data-carousel-dot': String(i),
      'aria-hidden': 'true',
      // The current-slide marker: a behavioural state no static L1 subtree can
      // express, so the module owns it (and the one invariant rule below).
      'data-carousel-current': i === 0 ? true : undefined,
    },
  }
})
const dotsNode = slots.dots && typeof slots.dots === 'object' ? [slots.dots] : []
const dots = renderL1Fragment(dotsNode, `${instanceId}-dots`, dotControls, { edit })
const slotCss = [slideCss, dots.css].filter(Boolean).join('\n')
---

<section
  class="carousel"
  data-carousel
  data-carousel-autoplay={autoplay ? '' : undefined}
  data-carousel-loop={loop ? '' : undefined}
>
  <ul class="carousel__track" role="list">
    {slideHtmls.map((html) => (
      <li class="carousel__slide" data-l1-slot="slide" set:html={html} />
    ))}
  </ul>

  {dots.htmls[0] && <Fragment set:html={dots.htmls[0]} />}

  {slotCss && <style set:html={slotCss} />}
</section>

<style>
  /*
   * REQ-96 — every rule here is behavioural mechanics or an invariant state
   * signal. There is deliberately no `gap`, no `flex-basis`, and nothing about a
   * dot's size or colour: a slide's width is its own L1 subtree's sizing, and a
   * dot's look is the L1 control node naming it.
   */

  /* The track — a pure CSS scroll-snap row: genuinely swipeable/scrollable, no JS. */
  .carousel__track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    width: 100%;
    scrollbar-width: none;
  }
  .carousel__track::-webkit-scrollbar { display: none; }

  /* A slide is a snap target sized by its own content — never by a view dial. */
  .carousel__slide {
    scroll-snap-align: center;
    flex: 0 0 auto;
    min-width: 0;
  }

  /*
   * REQ-116 — the settled state, for the edit render only.
   *
   * The slides are all in the DOM already (a scroll track, not `display: none`),
   * so their copy is reachable — but with behaviour off they sit scrolled out of
   * view, which makes them awkward to click and impossible to see. Nothing in
   * the edit channel is interactive enough to reveal them, so the track wraps
   * and every slide is on screen simultaneously.
   *
   * The rule keys off the document-level `data-fc-edit` marker the page
   * assembler sets on `<body>`, so it is inert in every other channel. Any future
   * behavior module that hides content behind its behaviour declares its own
   * settled state the same way — the channel does not need to know what a
   * carousel is.
   */
  [data-fc-edit] .carousel__track {
    flex-wrap: wrap;
    overflow-x: visible;
    scroll-snap-type: none;
  }

  /*
   * The one invariant state signal (DOC-25 §10.3): which slide is current must
   * be discernible, and a static L1 subtree has no state axis to say it with.
   * Opacity is the minimal, size- and colour-agnostic way to express it, so the
   * dot's actual look stays entirely L1's.
   */
  [data-carousel-dot] { opacity: 0.4; }
  [data-carousel-dot][data-carousel-current] { opacity: 1; }
</style>
