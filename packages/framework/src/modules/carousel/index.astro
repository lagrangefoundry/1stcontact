---
import type { L1Node } from '@1stcontact/site-schema'
import { renderL1Fragment } from '../../l1/render'

/**
 * `carousel` capability (REQ-79, reframed REQ-85). The vetted core owns only
 * behaviour: a pure CSS `scroll-snap` track (swipeable with **no client JS**,
 * per DOC-7's SSR-only rule), per-view slide sizing, and an optional decorative
 * dots row. Each slide's presentation is an **L1 subtree** mounted into the
 * repeated `slide` slot — the module never paints a slide, it wraps L1.
 *
 * Slot CSS is per-instance (geometry/colour vary by slide), so it is emitted as a
 * raw `<style>` in the body — self-closing in source, so `getModuleCss` (which
 * folds the static chrome `<style>` below) never double-emits it, while the
 * runtime `<style>` survives `renderToString`. `instanceId` namespaces the slot
 * classes so multiple carousels on a page never collide.
 */
interface Props {
  config?: Record<string, unknown>
  slots?: { slide?: L1Node[] }
  instanceId?: string
}

const { config = {}, slots = {}, instanceId = 'carousel' } = Astro.props as Props

const view = typeof config.view === 'string' ? config.view : 'single'
const controls = config.controls === 'dots' ? 'dots' : 'none'

// Isolation (REQ-85): malformed slot content must not break the page. Coerce to
// an array and drop any non-object subtree; the L1 renderer re-checks each value.
const slideNodes: L1Node[] = Array.isArray(slots.slide)
  ? slots.slide.filter((n): n is L1Node => !!n && typeof n === 'object')
  : []
const { htmls: slideHtmls, css: slotCss } = renderL1Fragment(slideNodes, `${instanceId}-slide`)
---

<section class:list={['carousel', `view-${view}`, `controls-${controls}`]} data-carousel>
  <ul class="carousel__track" role="list">
    {slideHtmls.map((html) => (
      <li class="carousel__slide" data-l1-slot="slide" set:html={html} />
    ))}
  </ul>

  {controls === 'dots' && slideNodes.length > 1 && (
    <div class="carousel__dots" aria-hidden="true">
      {slideNodes.map((_, i) => (
        <span class:list={['carousel__dot', i === 0 && 'is-active']} />
      ))}
    </div>
  )}

  {slotCss && <style set:html={slotCss} />}
</section>

<style>
  /* The track — a pure CSS scroll-snap row: genuinely swipeable/scrollable, no JS. */
  .carousel__track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-6);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    width: 100%;
    scrollbar-width: none;
  }
  .carousel__track::-webkit-scrollbar { display: none; }

  .carousel__slide {
    scroll-snap-align: center;
    flex: 0 0 100%;
    min-width: 0;
    box-sizing: border-box;
  }
  /* Slides-per-view — behavioural scroll sizing (not an aesthetic dial). `single`
     fills the view; `peek` leaves neighbours visible at the edges; `multi` fits
     several per view from the md breakpoint up. */
  .carousel.view-single .carousel__slide { flex-basis: 100%; }
  .carousel.view-peek .carousel__slide { flex-basis: 85%; }
  .carousel.view-multi .carousel__slide { flex-basis: 100%; }
  @media (min-width: 768px) {
    .carousel.view-peek .carousel__slide { flex-basis: 60%; }
    .carousel.view-multi .carousel__slide { flex-basis: calc((100% - 2 * var(--space-6)) / 3); }
  }

  /* Decorative pagination dots — an aria-hidden position indicator; the
     scrollable track is the real affordance. */
  .carousel__dots { display: flex; gap: var(--space-2); justify-content: center; margin-top: var(--space-4); }
  .carousel__dot {
    width: var(--space-2);
    height: var(--space-2);
    border-radius: var(--radius-full);
    background: var(--color-border);
  }
  .carousel__dot.is-active { background: var(--color-accent); }
</style>
