---
import type { AssetRef, NavEntry } from '@1stcontact/site-schema'
import { navHref } from '../nav'
import { assertSafeUrl } from '../safety'
import { BUILD_YEAR } from '../../buildInfo'

interface Props {
  variant?: string
  dials?: Record<string, string>
  content: {
    logo?: AssetRef | string
    tagline?: string
    copyrightHolder: string
    links?: NavEntry[]
    /** Social links (REQ-36) — rendered as bordered icon circles. Each `icon` is
     *  a glyph in the site's declared brand icon font (Font Awesome brands). */
    social?: { icon: string; href: string; label: string }[]
  }
}

const { dials = {}, content } = Astro.props as Props
const surface = dials.surface ?? 'inverse'
const spacingTop = dials.spacingTop ?? 'lg'
const spacingBottom = dials.spacingBottom ?? 'lg'
// Content layout: `center` stacks centred (default); `spread` justifies the
// copyright and links to opposite ends of one row.
const layout = dials.layout ?? 'center'

const { tagline, copyrightHolder } = content
const links = content.links ?? []
const social = content.social ?? []
const logo = content.logo
const logoIsImage = typeof logo === 'object' && logo !== null
// Build-time constant — keeps output deterministic across rebuilds.
const year = BUILD_YEAR
---

<footer
  class:list={[
    'footer',
    `surface-${surface}`,
    `layout-${layout}`,
    `spacing-top-${spacingTop}`,
    `spacing-bottom-${spacingBottom}`,
  ]}
>
  <div class="footer__inner">
    {logo && (
      <div class="footer__logo">
        {logoIsImage ? <img src={assertSafeUrl((logo as AssetRef).src, 'footer logo src')} alt={(logo as AssetRef).alt} /> : <span>{logo}</span>}
      </div>
    )}
    {tagline && <p class="footer__tagline">{tagline}</p>}

    {social.length > 0 && (
      <div class="footer__social">
        {social.map((s) => (
          <a class="footer__social-link" href={assertSafeUrl(s.href, 'footer social href')} aria-label={s.label}>
            <span aria-hidden="true">{s.icon}</span>
          </a>
        ))}
      </div>
    )}

    {links.length > 0 && (
      <nav class="footer__links" aria-label="Footer">
        {links.map((entry) => <a href={navHref(entry.target)}>{entry.label}</a>)}
      </nav>
    )}

    <p class="footer__copyright">© {year} {copyrightHolder}</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-surface-inverse);
    color: var(--color-bg);
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
  }
  .footer.surface-default { background: var(--color-bg); color: var(--color-text); border-top: 1px solid var(--color-border); }
  .footer.surface-subtle { background: var(--color-surface-subtle); color: var(--color-text); }
  .footer.surface-accent { background: var(--color-accent); color: var(--color-bg); }
  /* `accent-muted` (REQ-36) — a softer, less-saturated accent band (the reference
     footer uses a muted gold distinct from the bright accent used for headings). */
  .footer.surface-accent-muted { background: var(--color-accent-mid); color: var(--color-bg); }

  .footer.spacing-top-none { padding-top: var(--space-0); }
  .footer.spacing-top-sm { padding-top: var(--space-2); }
  .footer.spacing-top-md { padding-top: var(--space-4); }
  .footer.spacing-top-lg { padding-top: var(--space-8); }
  .footer.spacing-top-xl { padding-top: var(--space-12); }
  .footer.spacing-top-2xl { padding-top: var(--space-16); }
  .footer.spacing-top-3xl { padding-top: var(--space-24); }
  .footer.spacing-bottom-none { padding-bottom: var(--space-0); }
  .footer.spacing-bottom-sm { padding-bottom: var(--space-2); }
  .footer.spacing-bottom-md { padding-bottom: var(--space-4); }
  .footer.spacing-bottom-lg { padding-bottom: var(--space-8); }
  .footer.spacing-bottom-xl { padding-bottom: var(--space-12); }
  .footer.spacing-bottom-2xl { padding-bottom: var(--space-16); }
  .footer.spacing-bottom-3xl { padding-bottom: var(--space-24); }

  .footer__inner {
    max-width: var(--container-default);
    margin-inline: auto;
    padding-inline: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: center;
    text-align: center;
  }
  /* Spread layout: copyright and links justified to opposite ends of one row.
     `order` pulls the copyright ahead of the links so it reads left / links
     right, regardless of DOM order. Wraps to a stack on narrow viewports. */
  .footer.layout-spread .footer__inner {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    text-align: left;
  }
  .footer.layout-spread .footer__copyright { order: -1; }
  .footer__logo img { display: block; height: var(--space-8); width: auto; }
  .footer__logo span { font-weight: var(--font-weight-bold); }
  .footer__tagline { margin: 0; color: inherit; opacity: 0.85; }
  .footer__links { display: flex; flex-wrap: wrap; gap: var(--space-4); justify-content: center; }
  .footer__links a { color: inherit; text-decoration: none; font-size: var(--font-size-sm); }
  .footer__copyright { margin: 0; font-size: var(--font-size-sm); opacity: 0.7; }

  /* Social icon circles (REQ-36) — thin bordered rings with a brand glyph, the
     reference's Instagram / Facebook / Yelp row. The glyph is set in the site's
     declared brand icon font (Font Awesome brands). */
  .footer__social { display: flex; gap: var(--space-4); justify-content: center; }
  .footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--space-12);
    height: var(--space-12);
    border: 2px solid currentColor;
    border-radius: var(--radius-full);
    color: inherit;
    text-decoration: none;
  }
  .footer__social-link span {
    font-family: 'BrandFont';
    font-weight: 400;
    font-size: var(--font-size-lg);
    line-height: 1;
  }
</style>
