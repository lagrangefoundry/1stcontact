---
import { renderMarkdown } from '../markdown'

interface FormField {
  name: string
  label: string
  type: 'text' | 'email' | 'tel' | 'textarea'
  required: boolean
}

interface Props {
  variant?: string
  dials?: Record<string, string>
  content: {
    heading?: string
    subhead?: string
    action: string
    fields: FormField[]
    submitLabel?: string
    successMessage?: string
    caption?: string
  }
}

const { dials = {}, content } = Astro.props as Props
const surface = dials.surface ?? 'default'
const align = dials.align ?? 'left'
const spacingTop = dials.spacingTop ?? 'lg'
const spacingBottom = dials.spacingBottom ?? 'lg'
// `half` flexes the band into a shared two-column row (grouped by the pipeline).
const width = dials.width ?? 'full'
// Submit-button colour treatment (REQ-33): `primary` (brand) or dark `neutral`.
const submitTreatment = dials.submitTreatment ?? 'primary'
// Submit-label foreground (REQ-45): `auto` keeps the treatment's derived label
// colour; any palette role paints the label a framework-computed `var(--color-
// <role>)` (a closed role set, never instance-supplied raw CSS).
const submitForeground = dials.submitForeground ?? 'auto'
const submitStyle =
  submitForeground !== 'auto' ? `color: var(--color-${submitForeground});` : undefined
// Subhead / caption size (REQ-45).
const subheadSize = dials.subheadSize ?? 'md'
const captionSize = dials.captionSize ?? 'md'

const { heading, action } = content
const fields = content.fields ?? []
const submitLabel = content.submitLabel ?? 'Send'
const subheadHtml = content.subhead ? await renderMarkdown(content.subhead) : undefined
const captionHtml = content.caption ? await renderMarkdown(content.caption) : undefined
const successHtml = content.successMessage
  ? await renderMarkdown(content.successMessage)
  : '<p>Thanks — your message has been sent.</p>'
// Honeypot: hidden from humans, tempting to bots. The server rejects any
// submission where this is filled (wired in REQ-7).
const honeypotName = 'hp_company_url'
---

<section
  class:list={[
    'contact-form',
    `surface-${surface}`,
    `align-${align}`,
    `width-${width}`,
    `subhead-size-${subheadSize}`,
    `caption-size-${captionSize}`,
    `spacing-top-${spacingTop}`,
    `spacing-bottom-${spacingBottom}`,
  ]}
>
  <div class="contact-form__inner" data-contact-form-root>
    {heading && <h2 class="contact-form__heading">{heading}</h2>}
    {subheadHtml && <div class="contact-form__subhead" set:html={subheadHtml} />}

    <form class="contact-form__form" data-contact-form action={action} method="post">
      {fields.map((field) => (
        <div class="contact-form__field">
          <label for={`cf-${field.name}`}>{field.label}</label>
          {field.type === 'textarea' ? (
            <textarea id={`cf-${field.name}`} name={field.name} required={field.required} rows="5"></textarea>
          ) : (
            <input id={`cf-${field.name}`} name={field.name} type={field.type} required={field.required} />
          )}
        </div>
      ))}

      {/* Honeypot — visually hidden, off the tab order, never autofilled. */}
      <div class="contact-form__honeypot" aria-hidden="true">
        <label for={`cf-${honeypotName}`}>Leave this field empty</label>
        <input id={`cf-${honeypotName}`} name={honeypotName} type="text" tabindex="-1" autocomplete="off" />
      </div>

      {/* Turnstile mounts here (script + token wired in REQ-7); degrades cleanly. */}
      <div data-turnstile-target></div>

      <p class="contact-form__error" data-contact-error hidden></p>
      <button class:list={['contact-form__submit', `submit-${submitTreatment}`]} type="submit" style={submitStyle}>{submitLabel}</button>
    </form>

    {captionHtml && <div class="contact-form__caption" set:html={captionHtml} />}

    {/* Client enhancement swaps the form for this on a successful submit. */}
    <template data-contact-success set:html={successHtml}></template>
  </div>
</section>

<script>
  import { enhanceAllContactForms } from './enhance'
  enhanceAllContactForms()
</script>

<style>
  .contact-form { background: var(--color-bg); color: var(--color-text); }
  .contact-form.surface-subtle { background: var(--color-surface-subtle); }
  .contact-form.surface-inverse { background: var(--color-surface-inverse); color: var(--color-bg); }
  .contact-form.surface-accent { background: var(--color-accent); color: var(--color-bg); }

  .contact-form.spacing-top-none { padding-top: var(--space-0); }
  .contact-form.spacing-top-sm { padding-top: var(--space-4); }
  .contact-form.spacing-top-md { padding-top: var(--space-8); }
  .contact-form.spacing-top-lg { padding-top: var(--space-16); }
  .contact-form.spacing-top-xl { padding-top: var(--space-24); }
  .contact-form.spacing-bottom-none { padding-bottom: var(--space-0); }
  .contact-form.spacing-bottom-sm { padding-bottom: var(--space-4); }
  .contact-form.spacing-bottom-md { padding-bottom: var(--space-8); }
  .contact-form.spacing-bottom-lg { padding-bottom: var(--space-16); }
  .contact-form.spacing-bottom-xl { padding-bottom: var(--space-24); }

  .contact-form__inner {
    max-width: var(--container-narrow);
    margin-inline: auto;
    padding-inline: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .contact-form.align-center .contact-form__inner { align-items: center; text-align: center; }
  /* Half-width band: the shared `fc-row` supplies the container width and gutter,
     so the form inner runs fluid to fill its column. */
  .contact-form.width-half .contact-form__inner {
    max-width: none;
    margin-inline: 0;
    padding-inline: 0;
  }

  .contact-form__heading {
    margin: 0;
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-3xl);
    line-height: var(--line-height-tight);
  }
  .contact-form__subhead { color: var(--color-muted); }
  /* Subhead size (REQ-45): `md` preserves the prior inherited size, so a form
     that omits the dial is unchanged; `sm`/`lg` step it down/up. */
  .contact-form.subhead-size-sm .contact-form__subhead { font-size: var(--font-size-sm); }
  .contact-form.subhead-size-md .contact-form__subhead { font-size: var(--font-size-base); }
  .contact-form.subhead-size-lg .contact-form__subhead { font-size: var(--font-size-lg); }

  /* Small caption below the form (REQ-45) — fine print, sized by its own dial so
     it can read smaller than the subhead. */
  .contact-form__caption { color: var(--color-muted); }
  .contact-form.caption-size-sm .contact-form__caption { font-size: var(--font-size-sm); }
  .contact-form.caption-size-md .contact-form__caption { font-size: var(--font-size-base); }
  .contact-form.caption-size-lg .contact-form__caption { font-size: var(--font-size-lg); }

  .contact-form__form { display: flex; flex-direction: column; gap: var(--space-4); width: 100%; }
  .contact-form.align-center .contact-form__form { text-align: left; }
  .contact-form__field { display: flex; flex-direction: column; gap: var(--space-2); }
  .contact-form__field label { font-weight: var(--font-weight-medium); font-size: var(--font-size-sm); }
  .contact-form__field input,
  .contact-form__field textarea {
    font: inherit;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
  }
  .contact-form__field textarea { resize: vertical; }

  /* Honeypot is removed from the visual + accessibility tree without display:none
     (some bots skip display:none fields). */
  .contact-form__honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .contact-form__error { margin: 0; color: var(--color-accent); font-size: var(--font-size-sm); }

  .contact-form__submit {
    align-self: flex-start;
    /* Inherit the site font family + size — without this a <button> falls back
       to the UA default (Arial 13px), diverging from the site's type. Weight is
       set explicitly below so the label still reads as an action. */
    font: inherit;
    padding: var(--space-3) var(--space-6);
    border: 0;
    border-radius: var(--radius-md);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
  }
  /* Colour treatment (REQ-33). `primary` is the brand button; `neutral` is a
     high-contrast dark button (the theme's text colour) with a near-white label
     — e.g. a black "Send message" on a light band. */
  .contact-form__submit.submit-primary { background: var(--color-primary); color: var(--color-bg); }
  .contact-form__submit.submit-neutral { background: var(--color-text); color: var(--color-surface); }
  .contact-form.align-center .contact-form__submit { align-self: center; }
</style>
