---
import { renderMarkdown } from '../markdown'

interface FormField {
  name: string
  label: string
  type: 'text' | 'email' | 'tel' | 'textarea'
  required: boolean
}

interface Props {
  variant?: string
  dials?: Record<string, string>
  content: {
    heading?: string
    subhead?: string
    action: string
    fields: FormField[]
    submitLabel?: string
    successMessage?: string
  }
}

const { dials = {}, content } = Astro.props as Props
const surface = dials.surface ?? 'default'
const align = dials.align ?? 'left'
const spacingTop = dials.spacingTop ?? 'lg'
const spacingBottom = dials.spacingBottom ?? 'lg'

const { heading, action } = content
const fields = content.fields ?? []
const submitLabel = content.submitLabel ?? 'Send'
const subheadHtml = content.subhead ? await renderMarkdown(content.subhead) : undefined
const successHtml = content.successMessage
  ? await renderMarkdown(content.successMessage)
  : '<p>Thanks — your message has been sent.</p>'
// Honeypot: hidden from humans, tempting to bots. The server rejects any
// submission where this is filled (wired in REQ-7).
const honeypotName = 'hp_company_url'
---

<section
  class:list={[
    'contact-form',
    `surface-${surface}`,
    `align-${align}`,
    `spacing-top-${spacingTop}`,
    `spacing-bottom-${spacingBottom}`,
  ]}
>
  <div class="contact-form__inner" data-contact-form-root>
    {heading && <h2 class="contact-form__heading">{heading}</h2>}
    {subheadHtml && <div class="contact-form__subhead" set:html={subheadHtml} />}

    <form class="contact-form__form" data-contact-form action={action} method="post">
      {fields.map((field) => (
        <div class="contact-form__field">
          <label for={`cf-${field.name}`}>{field.label}</label>
          {field.type === 'textarea' ? (
            <textarea id={`cf-${field.name}`} name={field.name} required={field.required} rows="5"></textarea>
          ) : (
            <input id={`cf-${field.name}`} name={field.name} type={field.type} required={field.required} />
          )}
        </div>
      ))}

      {/* Honeypot — visually hidden, off the tab order, never autofilled. */}
      <div class="contact-form__honeypot" aria-hidden="true">
        <label for={`cf-${honeypotName}`}>Leave this field empty</label>
        <input id={`cf-${honeypotName}`} name={honeypotName} type="text" tabindex="-1" autocomplete="off" />
      </div>

      {/* Turnstile mounts here (script + token wired in REQ-7); degrades cleanly. */}
      <div data-turnstile-target></div>

      <p class="contact-form__error" data-contact-error hidden></p>
      <button class="contact-form__submit" type="submit">{submitLabel}</button>
    </form>

    {/* Client enhancement swaps the form for this on a successful submit. */}
    <template data-contact-success set:html={successHtml}></template>
  </div>
</section>

<script>
  import { enhanceAllContactForms } from './enhance'
  enhanceAllContactForms()
</script>

<style>
  .contact-form { background: var(--color-bg); color: var(--color-text); }
  .contact-form.surface-subtle { background: var(--color-surface-subtle); }
  .contact-form.surface-inverse { background: var(--color-surface-inverse); color: var(--color-bg); }
  .contact-form.surface-accent { background: var(--color-accent); color: var(--color-bg); }

  .contact-form.spacing-top-none { padding-top: var(--space-0); }
  .contact-form.spacing-top-sm { padding-top: var(--space-4); }
  .contact-form.spacing-top-md { padding-top: var(--space-8); }
  .contact-form.spacing-top-lg { padding-top: var(--space-16); }
  .contact-form.spacing-top-xl { padding-top: var(--space-24); }
  .contact-form.spacing-bottom-none { padding-bottom: var(--space-0); }
  .contact-form.spacing-bottom-sm { padding-bottom: var(--space-4); }
  .contact-form.spacing-bottom-md { padding-bottom: var(--space-8); }
  .contact-form.spacing-bottom-lg { padding-bottom: var(--space-16); }
  .contact-form.spacing-bottom-xl { padding-bottom: var(--space-24); }

  .contact-form__inner {
    max-width: var(--container-narrow);
    margin-inline: auto;
    padding-inline: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .contact-form.align-center .contact-form__inner { align-items: center; text-align: center; }

  .contact-form__heading {
    margin: 0;
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-3xl);
    line-height: var(--line-height-tight);
  }
  .contact-form__subhead { color: var(--color-muted); }

  .contact-form__form { display: flex; flex-direction: column; gap: var(--space-4); width: 100%; }
  .contact-form.align-center .contact-form__form { text-align: left; }
  .contact-form__field { display: flex; flex-direction: column; gap: var(--space-2); }
  .contact-form__field label { font-weight: var(--font-weight-medium); font-size: var(--font-size-sm); }
  .contact-form__field input,
  .contact-form__field textarea {
    font: inherit;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
  }
  .contact-form__field textarea { resize: vertical; }

  /* Honeypot is removed from the visual + accessibility tree without display:none
     (some bots skip display:none fields). */
  .contact-form__honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .contact-form__error { margin: 0; color: var(--color-accent); font-size: var(--font-size-sm); }

  .contact-form__submit {
    align-self: flex-start;
    background: var(--color-primary);
    color: var(--color-bg);
    padding: var(--space-3) var(--space-6);
    border: 0;
    border-radius: var(--radius-md);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
  }
  .contact-form.align-center .contact-form__submit { align-self: center; }
</style>
