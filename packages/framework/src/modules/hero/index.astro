---
import type { AssetRef } from '@1stcontact/site-schema'
import { assertSafeUrl } from '../safety'
import { resolveTextStyle, type TextRun } from '../text-style'

interface Props {
  variant?: string
  dials?: Record<string, string>
  content: {
    eyebrow?: TextRun
    heading: TextRun
    subhead?: TextRun
    cta?: TextRun
    image?: AssetRef
    portrait?: AssetRef
  }
}

const { variant = 'bg-color', dials = {}, content } = Astro.props as Props
const align = dials.align ?? 'left'
const surface = dials.surface ?? 'default'
const spacingTop = dials.spacingTop ?? 'lg'
const spacingBottom = dials.spacingBottom ?? 'lg'
// Heading letter-case (REQ-36) — `upper` uppercases at render; DOM text literal.
const headingCase = dials.headingCase ?? 'normal'
// CTA corner shape (REQ-36) — `round` (default) pill; `square`/`soft` variants.
const ctaShape = dials.ctaShape ?? 'round'
// Top-of-band gradient scrim (REQ-36) — `top` darkens the band's top edge.
const scrimGradient = dials.scrimGradient ?? 'none'
// Divider rule between heading and subhead (REQ-36) — `rule` draws the rule.
const divider = dials.divider ?? 'none'
// Content-column horizontal placement (REQ-36) — `left` hugs the left gutter.
const contentColumn = dials.contentColumn ?? 'center'
// Band height: `fold` fills the viewport to the fold; `auto` sizes to content.
const height = dials.height ?? 'auto'
// Legibility scrim + content anchor (REQ-32).
const scrim = dials.scrim ?? 'none'
const contentAnchor = dials.contentAnchor ?? 'center'
// Fixed top inset for content within a `fold` band (REQ-49).
const contentOffsetTop = dials.contentOffsetTop ?? 'none'
// Subhead/body content-column width (REQ-49).
const contentWidth = dials.contentWidth ?? 'default'
// Content horizontal inset / gutter (REQ-49 cap 5).
const contentInset = dials.contentInset ?? 'sm'

const { eyebrow, heading, subhead, cta, portrait } = content
// Foreground portrait (REQ-36) — an optional attribution/testimonial avatar
// rendered above the subhead; `portraitShape` crops it (circle default).
const portraitShape = dials.portraitShape ?? 'circle'
// Explicit heading line breaks (REQ-36): a newline in the heading text renders
// as a `<br>` so a display heading breaks exactly where the reference does,
// without capping the measure. Each segment stays an escaped text node.
const headingLines = (heading?.text ?? '').split('\n')
// The background image is rendered for the bg-image variant only.
const bgImage = variant === 'bg-image' ? content.image : undefined

// REQ-50 — resolve each styled run to an inline `style` declaration. A run's
// literal values emit verbatim in the report's units; its aliases resolve to
// the `var(--…)` theme custom properties. An absent run yields ''.
const eyebrowStyle = resolveTextStyle(eyebrow)
const headingStyle = resolveTextStyle(heading)
const subheadStyle = resolveTextStyle(subhead)
const ctaStyle = resolveTextStyle(cta)
---

<section
  class:list={[
    'hero',
    `variant-${variant}`,
    `align-${align}`,
    `surface-${surface}`,
    `height-${height}`,
    `scrim-${scrim}`,
    `anchor-${contentAnchor}`,
    `content-offset-top-${contentOffsetTop}`,
    `content-width-${contentWidth}`,
    `content-inset-${contentInset}`,
    `content-column-${contentColumn}`,
    `scrim-gradient-${scrimGradient}`,
    `spacing-top-${spacingTop}`,
    `spacing-bottom-${spacingBottom}`,
  ]}
>
  {bgImage && <img class="hero__bg" src={assertSafeUrl(bgImage.src, 'hero image src')} alt={bgImage.alt} />}
  {bgImage && scrim !== 'none' && <div class="hero__scrim" aria-hidden="true"></div>}
  {bgImage && scrimGradient !== 'none' && <div class="hero__scrim-top" aria-hidden="true"></div>}

  <div class="hero__inner">
    {eyebrow?.text && <p class="hero__eyebrow" style={eyebrowStyle}>{eyebrow.text}</p>}
    <h1 class:list={['hero__heading', `case-${headingCase}`]} style={headingStyle}>{headingLines.map((line, i) => <Fragment>{i > 0 && <br />}{line}</Fragment>)}</h1>
    {divider === 'rule' && <hr class="hero__divider" />}
    {portrait && <img class:list={['hero__portrait', `portrait-${portraitShape}`]} src={assertSafeUrl(portrait.src, 'hero portrait src')} alt={portrait.alt} />}
    {subhead?.text && <p class="hero__subhead" style={subheadStyle}>{subhead.text}</p>}
    {cta?.label && cta.href && <a class:list={['hero__cta', `cta-${ctaShape}`]} style={ctaStyle} href={assertSafeUrl(cta.href, 'hero cta href')}>{cta.label}</a>}
  </div>
</section>

<style>
  .hero { position: relative; background: var(--color-bg); color: var(--color-text); overflow: hidden; }
  .hero.surface-subtle { background: var(--color-surface-subtle); }
  .hero.surface-inverse { background: var(--color-surface-inverse); color: var(--color-bg); }
  .hero.surface-accent { background: var(--color-accent); color: var(--color-bg); }

  /* Height dial: `fold` fills the viewport to the fold and centres the content
     vertically. `box-sizing: border-box` (base reset) keeps the padding inside
     the 100vh, so the band is exactly the fold. */
  .hero.height-fold {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  /* As a flex item the inner would shrink to its content; `width: 100%` keeps it
     spanning the container so the content stays left-aligned with bands below. */
  .hero.height-fold .hero__inner { width: 100%; }

  /* Content anchor (REQ-32): where the content sits within a `fold` band. */
  .hero.height-fold.anchor-top { justify-content: flex-start; }
  .hero.height-fold.anchor-bottom { justify-content: flex-end; }

  /* Fixed top inset for a `fold` hero's content (REQ-49): a token-backed distance
     from the band top, independent of the flex anchor. */
  .hero.height-fold.content-offset-top-sm .hero__inner { margin-top: var(--space-16); }
  .hero.height-fold.content-offset-top-md .hero__inner { margin-top: var(--space-32); }
  .hero.height-fold.content-offset-top-lg .hero__inner { margin-top: var(--space-48); }
  .hero.height-fold.content-offset-top-xl .hero__inner { margin-top: var(--space-80); }

  .hero.spacing-top-none { padding-top: var(--space-0); }
  .hero.spacing-top-sm { padding-top: var(--space-4); }
  .hero.spacing-top-md { padding-top: var(--space-8); }
  .hero.spacing-top-lg { padding-top: var(--space-16); }
  .hero.spacing-top-xl { padding-top: var(--space-24); }
  .hero.spacing-top-2xl { padding-top: var(--space-32); }
  .hero.spacing-top-3xl { padding-top: var(--space-48); }
  .hero.spacing-bottom-none { padding-bottom: var(--space-0); }
  .hero.spacing-bottom-sm { padding-bottom: var(--space-4); }
  .hero.spacing-bottom-md { padding-bottom: var(--space-8); }
  .hero.spacing-bottom-lg { padding-bottom: var(--space-16); }
  .hero.spacing-bottom-xl { padding-bottom: var(--space-24); }
  .hero.spacing-bottom-2xl { padding-bottom: var(--space-32); }
  .hero.spacing-bottom-3xl { padding-bottom: var(--space-48); }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  /* Legibility scrim (REQ-32; REQ-36): a dark tint painted over the image at a
     strength set by the scrim dial. Keyed to `--color-scrim`. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--color-scrim);
  }
  .hero.scrim-light .hero__scrim { opacity: 0.2; }
  .hero.scrim-medium .hero__scrim { opacity: 0.35; }
  .hero.scrim-strong .hero__scrim { opacity: 0.55; }
  .hero.scrim-heavy .hero__scrim { opacity: 0.68; }
  /* Top-of-band gradient scrim (REQ-36): a downward dark gradient over the flat
     scrim, darkening the top edge (behind the nav) and fading out ~40% down. */
  .hero__scrim-top {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: linear-gradient(to bottom, var(--color-scrim), transparent 38%);
  }
  .hero.scrim-gradient-top .hero__scrim-top { opacity: 0.5; }
  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: var(--container-default);
    margin-inline: auto;
    padding-inline: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  /* Content horizontal inset / gutter (REQ-49 cap 5): the `padding-inline` as a
     token step, so the front-door left edge can align to a reference's gutter. */
  .hero.content-inset-md .hero__inner { padding-inline: var(--space-6); }
  .hero.content-inset-lg .hero__inner { padding-inline: var(--space-8); }
  .hero.align-center .hero__inner { align-items: center; text-align: center; }
  /* Content-column placement (REQ-36): `left` drops the auto start-margin so the
     capped column hugs the band's left gutter. */
  .hero.content-column-left .hero__inner { margin-inline: 0 auto; }

  /* Divider rule (REQ-36): a thin rule between heading and subhead inheriting the
     surface text colour, capped to a short measure. */
  .hero__divider {
    width: 32rem;
    max-width: 100%;
    height: 0;
    margin: 0;
    border: 0;
    border-top: 2px solid currentColor;
  }

  /* Foreground portrait (REQ-36) — an attribution/testimonial avatar above the
     subhead. `circle` crops it round; a thin surface-colour ring lifts it off a
     busy background image. */
  .hero__portrait {
    display: block;
    width: 7rem;
    height: 7rem;
    object-fit: cover;
    margin: 0 0 var(--space-4);
    border: 2px solid currentColor;
  }
  .hero__portrait.portrait-circle { border-radius: 50%; }
  .hero__portrait.portrait-square { border-radius: var(--radius-md); }
  .hero.align-center .hero__portrait { margin-inline: auto; }

  /* REQ-50 — base slot styling supplies the *defaults* an omitting run inherits;
     any axis a styled run sets is emitted as an inline `style` and overrides the
     base. Intrinsic typography (family/size/weight/colour/tracking/leading/
     gradient) now lives on the run, not on a dial. */
  .hero__eyebrow {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-muted);
  }
  .hero__heading {
    margin: 0;
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    /* Default responsive size when the run omits `fontSizePx`; a literal px on
       the run replaces this with a fixed size (REQ-50 agreed fork). */
    font-size: clamp(var(--font-size-3xl), 6vw, var(--font-size-4xl));
  }
  /* Heading letter-case (REQ-36) — uppercases the rendered heading; DOM literal. */
  .hero__heading.case-upper { text-transform: uppercase; }

  .hero__subhead { margin: 0; font-size: var(--font-size-xl); }
  .hero.align-center .hero__subhead { margin-inline: auto; }
  /* Subhead/body content-column width (REQ-49): caps the measure so it can match
     a reference's column; `default` sets no cap (fills the inner frame). */
  .hero.content-width-narrow .hero__subhead { max-width: var(--container-narrow); }
  .hero.content-width-readable .hero__subhead { max-width: var(--container-readable); }
  .hero.content-width-wide .hero__subhead { max-width: var(--container-wide); }

  .hero__cta {
    display: inline-block;
    background: var(--color-primary);
    color: var(--color-bg);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    font-weight: var(--font-weight-semibold);
    text-align: center;
    text-decoration: none;
  }
  /* CTA corner shape (REQ-36) — `round` is the pill radius above; `square`
     hard-corners; `soft` is the reference's barely-rounded 2px button. */
  .hero__cta.cta-square { border-radius: 0; }
  .hero__cta.cta-soft { border-radius: 2px; }
  /* The inner is a stretch flex column, which would stretch the CTA into a
     full-width bar. Pin it to the content-start edge so it hugs its label. */
  .hero.align-left .hero__cta { align-self: flex-start; }
</style>
