---
import type { AssetRef } from '@1stcontact/site-schema'
import { renderMarkdown } from '../markdown'
import { assertSafeUrl } from '../safety'
import { gradientTextStyle, type GradientTreatment } from '../gradient'

interface Props {
  variant?: string
  dials?: Record<string, string>
  content: {
    eyebrow?: string
    heading: string
    subhead?: string
    cta?: { label: string; href: string }
    image?: AssetRef
    headingGradient?: GradientTreatment
  }
}

const { variant = 'bg-color', dials = {}, content } = Astro.props as Props
const size = dials.size ?? 'md'
const align = dials.align ?? 'left'
const surface = dials.surface ?? 'default'
const spacingTop = dials.spacingTop ?? 'lg'
const spacingBottom = dials.spacingBottom ?? 'lg'
// Heading colour treatment (REQ-28), independent of the surface text colour.
const headingTreatment = dials.headingTreatment ?? 'plain'
// Band height: `fold` fills the viewport to the fold; `auto` sizes to content.
const height = dials.height ?? 'auto'
// Legibility scrim + content anchor (REQ-32).
const scrim = dials.scrim ?? 'none'
const contentAnchor = dials.contentAnchor ?? 'center'
// Fixed top inset for content within a `fold` band (REQ-49): `none` (default)
// applies no inset; `sm`..`xl` step a token-backed distance from the band top,
// a separate axis from the flex `contentAnchor`.
const contentOffsetTop = dials.contentOffsetTop ?? 'none'
// Subhead/body colour (REQ-33): `inherit` keeps the surface colour; any palette
// role tints the whole subhead block. Framework-computed inline style (a closed
// role set), never instance-supplied raw CSS — mirrors the gradient treatment.
const subheadColor = dials.subheadColor ?? 'inherit'
const subheadStyle =
  subheadColor !== 'inherit' ? `color: var(--color-${subheadColor});` : undefined
// Subhead/body scale (REQ-33), independent of the heading `size`.
const subheadSize = dials.subheadSize ?? 'md'
// Subhead/body content-column width (REQ-49): `default` fills the inner frame
// (the prior hardcoded 60ch cap is removed); `narrow`/`wide` cap the measure to
// the matching container token so the lead/body can match a reference column.
const contentWidth = dials.contentWidth ?? 'default'
// Subhead/body font-weight (REQ-49): `regular` (default) keeps the inherited
// body weight; `light`/`medium`/`semibold` set the lead/body weight.
const subheadWeight = dials.subheadWeight ?? 'regular'
// Heading letter-spacing (REQ-45): `normal` leaves the heading untracked.
const tracking = dials.tracking ?? 'normal'
// Subhead line-height (REQ-45; `snug` REQ-49): `relaxed` preserves the prior leading.
const subheadLeading = dials.subheadLeading ?? 'relaxed'

const { eyebrow, heading, subhead, cta } = content
// The background image is rendered for the bg-image variant only.
const bgImage = variant === 'bg-image' ? content.image : undefined
// Structured gradient heading (REQ-32): framework-computed clipped gradient,
// used only when the treatment dial selects it.
const headingGradient =
  headingTreatment === 'gradient' ? gradientTextStyle(content.headingGradient) : undefined
// Subhead is markdown (schema type `markdown`): render it so multi-paragraph
// copy keeps its structure (a subhead line + body paragraphs) rather than
// collapsing into one run-on string.
const subheadHtml = subhead ? await renderMarkdown(subhead) : undefined
---

<section
  class:list={[
    'hero',
    `variant-${variant}`,
    `size-${size}`,
    `align-${align}`,
    `surface-${surface}`,
    `height-${height}`,
    `scrim-${scrim}`,
    `anchor-${contentAnchor}`,
    `content-offset-top-${contentOffsetTop}`,
    `subhead-size-${subheadSize}`,
    `content-width-${contentWidth}`,
    `subhead-weight-${subheadWeight}`,
    `subhead-leading-${subheadLeading}`,
    `spacing-top-${spacingTop}`,
    `spacing-bottom-${spacingBottom}`,
  ]}
>
  {bgImage && <img class="hero__bg" src={assertSafeUrl(bgImage.src, 'hero image src')} alt={bgImage.alt} />}
  {bgImage && scrim !== 'none' && <div class="hero__scrim" aria-hidden="true"></div>}

  <div class="hero__inner">
    {eyebrow && <p class="hero__eyebrow">{eyebrow}</p>}
    <h1 class:list={['hero__heading', `treatment-${headingTreatment}`, `tracking-${tracking}`]} style={headingGradient}>{heading}</h1>
    {subheadHtml && <div class="hero__subhead" style={subheadStyle} set:html={subheadHtml} />}
    {cta && <a class="hero__cta" href={assertSafeUrl(cta.href, 'hero cta href')}>{cta.label}</a>}
  </div>
</section>

<style>
  .hero { position: relative; background: var(--color-bg); color: var(--color-text); overflow: hidden; }
  .hero.surface-subtle { background: var(--color-surface-subtle); }
  .hero.surface-inverse { background: var(--color-surface-inverse); color: var(--color-bg); }
  .hero.surface-accent { background: var(--color-accent); color: var(--color-bg); }

  /* Height dial: `fold` fills the viewport to the fold and centres the content
     vertically, so a bg-image hero (and any header composited over it) fills the
     screen. `box-sizing: border-box` (base reset) keeps the padding inside the
     100vh, so the band is exactly the fold. */
  .hero.height-fold {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  /* As a flex item the inner would shrink to its content and the auto margins
     would centre that narrow block; `width: 100%` keeps it spanning the
     container so the content stays left-aligned with the bands below. */
  .hero.height-fold .hero__inner { width: 100%; }

  /* Content anchor (REQ-32): where the content sits within a `fold` band.
     `center` is the default height-fold behaviour; `top`/`bottom` push the
     content to the band's start/end. No effect on an `auto`-height band. */
  .hero.height-fold.anchor-top { justify-content: flex-start; }
  .hero.height-fold.anchor-bottom { justify-content: flex-end; }

  /* Fixed top inset for a `fold` hero's content (REQ-49): a deliberate
     token-backed distance from the band top, independent of the flex anchor —
     paired with `anchor-top` it pins the content N px from the top (the
     reference's `pt-80` = 320px). `none` (default) sets nothing, so a hero that
     omits the dial is unchanged. Token-backed via the extended `--space-*`
     scale; no effect on an `auto`-height band. */
  .hero.height-fold.content-offset-top-sm .hero__inner { margin-top: var(--space-16); }
  .hero.height-fold.content-offset-top-md .hero__inner { margin-top: var(--space-32); }
  .hero.height-fold.content-offset-top-lg .hero__inner { margin-top: var(--space-48); }
  .hero.height-fold.content-offset-top-xl .hero__inner { margin-top: var(--space-80); }

  .hero.spacing-top-none { padding-top: var(--space-0); }
  .hero.spacing-top-sm { padding-top: var(--space-4); }
  .hero.spacing-top-md { padding-top: var(--space-8); }
  .hero.spacing-top-lg { padding-top: var(--space-16); }
  .hero.spacing-top-xl { padding-top: var(--space-24); }
  .hero.spacing-bottom-none { padding-bottom: var(--space-0); }
  .hero.spacing-bottom-sm { padding-bottom: var(--space-4); }
  .hero.spacing-bottom-md { padding-bottom: var(--space-8); }
  .hero.spacing-bottom-lg { padding-bottom: var(--space-16); }
  .hero.spacing-bottom-xl { padding-bottom: var(--space-24); }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  /* Legibility scrim (REQ-32): a dark-neutral tint painted over the image (z 0,
     above the bg, below the content at z 1) at a strength set by the scrim dial.
     Keyed to `--color-surface-inverse` so the tint tracks the theme's dark
     neutral rather than a hard-coded colour. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--color-surface-inverse);
  }
  .hero.scrim-light .hero__scrim { opacity: 0.2; }
  .hero.scrim-medium .hero__scrim { opacity: 0.35; }
  .hero.scrim-strong .hero__scrim { opacity: 0.55; }
  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: var(--container-default);
    margin-inline: auto;
    padding-inline: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .hero.align-center .hero__inner { align-items: center; text-align: center; }

  .hero__eyebrow {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-muted);
  }
  .hero__heading {
    margin: 0;
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
  }
  /* Heading letter-spacing (REQ-45): only the tighter steps emit an override;
     `normal` sets nothing, leaving the heading untracked (default fallback
     unchanged). Token-backed so no raw em value reaches the page. */
  .hero__heading.tracking-tight { letter-spacing: var(--tracking-tight); }
  .hero__heading.tracking-tighter { letter-spacing: var(--tracking-tighter); }
  /* Heading colour treatment (REQ-28) — overrides the inherited surface colour.
     `accent` is a solid accent fill; `gold` is the metallic-gold gradient
     clipped to the glyphs, matching the header wordmark (REQ-24). */
  .hero__heading.treatment-accent { color: var(--color-accent); }
  .hero__heading.treatment-gold {
    background-image: linear-gradient(
      180deg,
      #f7e4a8 0%,
      var(--color-accent) 48%,
      #b07d24 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  /* Responsive type: clamp between scale steps per size dial. */
  .hero.size-sm .hero__heading { font-size: clamp(var(--font-size-2xl), 4vw, var(--font-size-3xl)); }
  .hero.size-md .hero__heading { font-size: clamp(var(--font-size-3xl), 6vw, var(--font-size-4xl)); }
  .hero.size-lg .hero__heading { font-size: clamp(var(--font-size-4xl), 8vw, var(--font-size-5xl)); }

  .hero__subhead { font-size: var(--font-size-lg); }
  /* Subhead/body content-column width (REQ-49): caps the lead/body measure so it
     can match a reference's column (e.g. 768px). `content-width-default` sets no
     cap — the subhead fills the inner frame — replacing the prior hardcoded
     `max-width: 60ch`; `narrow`/`wide` use the matching container tokens. The
     `align` dial then places the capped column (left gutter or centred).
     Token-backed, no raw measure. */
  .hero.content-width-narrow .hero__subhead { max-width: var(--container-narrow); }
  .hero.content-width-wide .hero__subhead { max-width: var(--container-wide); }
  /* Subhead/body font-weight (REQ-49): `regular` (default) emits no override so
     the subhead keeps the inherited body weight and a hero that omits the dial
     is unchanged; the other steps set a token-backed weight (`light` = 300 for a
     delicate lead). */
  .hero.subhead-weight-light .hero__subhead { font-weight: var(--font-weight-light); }
  .hero.subhead-weight-medium .hero__subhead { font-weight: var(--font-weight-medium); }
  .hero.subhead-weight-semibold .hero__subhead { font-weight: var(--font-weight-semibold); }
  /* Subhead line-height (REQ-45; `snug` REQ-49): `relaxed` preserves the prior
     leading, so a hero that omits the dial is unchanged; the tighter steps
     densen the block, with `snug` (~1.33) the intermediate step. */
  .hero.subhead-leading-relaxed .hero__subhead { line-height: var(--line-height-relaxed); }
  .hero.subhead-leading-normal .hero__subhead { line-height: var(--line-height-normal); }
  .hero.subhead-leading-snug .hero__subhead { line-height: var(--line-height-snug); }
  .hero.subhead-leading-tight .hero__subhead { line-height: var(--line-height-tight); }
  .hero.align-center .hero__subhead { margin-inline: auto; }
  /* Markdown subhead: the lead paragraph reads as a prominent subhead line;
     any following paragraphs are the smaller body copy. The subhead-size dial
     (REQ-33) steps the lead/body pair together; `md` preserves the prior scale. */
  .hero__subhead p { margin: 0; }
  .hero__subhead p + p { margin-top: var(--space-4); }
  .hero.subhead-size-sm .hero__subhead p:first-child { font-size: var(--font-size-lg); }
  .hero.subhead-size-sm .hero__subhead p + p { font-size: var(--font-size-sm); }
  .hero.subhead-size-md .hero__subhead p:first-child { font-size: var(--font-size-xl); }
  .hero.subhead-size-md .hero__subhead p + p { font-size: var(--font-size-base); }
  .hero.subhead-size-lg .hero__subhead p:first-child { font-size: var(--font-size-2xl); }
  .hero.subhead-size-lg .hero__subhead p + p { font-size: var(--font-size-lg); }

  .hero__cta {
    display: inline-block;
    background: var(--color-primary);
    color: var(--color-bg);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }
</style>
