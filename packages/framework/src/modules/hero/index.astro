---
import type { AssetRef } from '@1stcontact/site-schema'
import { assertSafeUrl } from '../safety'
import { positionVars } from '../layer'
import { resolveContainerWidth, resolveStep, SPACING_STEPS, CTA_RADIUS_STEPS } from '../dials'
import { resolveTextStyle, type TextRun } from '../text-style'

interface Props {
  variant?: string
  dials?: Record<string, string>
  content: {
    eyebrow?: TextRun
    heading: TextRun
    subhead?: TextRun
    cta?: TextRun
    image?: AssetRef
    portrait?: AssetRef
  }
}

const { variant = 'bg-color', dials = {}, content } = Astro.props as Props
const align = dials.align ?? 'left'
const surface = dials.surface ?? 'default'
// Vertical spacing (REQ-58 absolute-or-overlay) — step OR absolute px.
const padTopCss = resolveStep(dials.spacingTop, SPACING_STEPS, 'lg')
const padBottomCss = resolveStep(dials.spacingBottom, SPACING_STEPS, 'lg')
// Heading letter-case (REQ-36) — `upper` uppercases at render; DOM text literal.
const headingCase = dials.headingCase ?? 'normal'
// CTA corner shape (REQ-36) — `round` (default) pill; `square`/`soft` variants.
// CTA corner radius (REQ-58 absolute-or-overlay) — named shape OR absolute px.
const ctaRadiusCss = resolveStep(dials.ctaShape, CTA_RADIUS_STEPS, 'round')
// Top-of-band gradient scrim (REQ-36) — `top` darkens the band's top edge.
const scrimGradient = dials.scrimGradient ?? 'none'
// Divider rule between heading and subhead (REQ-36) — `rule` draws the rule.
const divider = dials.divider ?? 'none'
// Content-column horizontal placement (REQ-36) — `left` hugs the left gutter.
const contentColumn = dials.contentColumn ?? 'center'
// Band height: `fold` fills the viewport to the fold; `auto` sizes to content.
const height = dials.height ?? 'auto'
// Legibility scrim + content anchor (REQ-32).
const scrim = dials.scrim ?? 'none'
const contentAnchor = dials.contentAnchor ?? 'center'
// Fixed top inset for content within a `fold` band (REQ-49).
// Content offset / inset (REQ-58 absolute-or-overlay) — named step OR absolute px.
const OFFSET_STEPS = { none: '0', sm: 'var(--space-16)', md: 'var(--space-32)', lg: 'var(--space-48)', xl: 'var(--space-80)' }
const offsetTopCss = resolveStep(dials.contentOffsetTop, OFFSET_STEPS, 'none')
// Subhead/body content-column width (REQ-49).
// Constrained content column (REQ-45 capability, REQ-55 scale + literal). Resolves
// to a max-width length applied via the `--fc-content-width` custom property, or
// null (`bleed`/absent → fills the frame).
const contentWidthCss = resolveContainerWidth(dials.contentWidth)
// Content horizontal inset / gutter (REQ-49 cap 5).
const INSET_STEPS = { sm: 'var(--space-4)', md: 'var(--space-6)', lg: 'var(--space-8)' }
const insetCss = resolveStep(dials.contentInset, INSET_STEPS, 'sm')

const { eyebrow, heading, subhead, cta, portrait } = content
// Foreground portrait (REQ-36) — an optional attribution/testimonial avatar
// rendered above the subhead; `portraitShape` crops it (circle default).
const portraitShape = dials.portraitShape ?? 'circle'
// Explicit heading line breaks (REQ-36): a newline in the heading text renders
// as a `<br>` so a display heading breaks exactly where the reference does,
// without capping the measure. Each segment stays an escaped text node.
const headingLines = (heading?.text ?? '').split('\n')
// The background image is rendered for the bg-image variant only.
const bgImage = variant === 'bg-image' ? content.image : undefined

// REQ-50 — resolve each styled run to an inline `style` declaration. A run's
// literal values emit verbatim in the report's units; its aliases resolve to
// the `var(--…)` theme custom properties. An absent run yields ''.
const eyebrowStyle = resolveTextStyle(eyebrow)
const headingStyle = resolveTextStyle(heading)
const subheadStyle = resolveTextStyle(subhead)
const ctaStyle = resolveTextStyle(cta)

// REQ-52 — free per-object positioning. A slot whose styled run carries a
// `position` is lifted out of the normal `.hero__inner` flow into the absolute
// `.hero__stack` (which spans the full band, `inset:0`), and placed by the
// framework's `--fc-*` coordinate model — the same one layer children use, so no
// instance CSS reaches the page. Slots without a `position` flow exactly as
// before, so every existing hero is unchanged. This makes the whole hero segment
// (with the overlaid wordmark) one art-direction canvas.
const withPos = (base: string, run?: TextRun): string => {
  if (!run?.position) return base
  const vars = positionVars(run.position)
  // `resolveTextStyle` yields a declaration string with no trailing `;`, so join
  // with one — otherwise the first `--fc-*` fuses onto the last declaration and
  // is dropped as invalid.
  return base ? `${base.replace(/\s*;?\s*$/, '')}; ${vars}` : vars
}
const anyPositioned = [eyebrow, heading, subhead, cta].some((r) => r?.position)
---

<section
  class:list={[
    'hero',
    `variant-${variant}`,
    `align-${align}`,
    `surface-${surface}`,
    `height-${height}`,
    `scrim-${scrim}`,
    `anchor-${contentAnchor}`,
    { 'has-content-width': contentWidthCss !== null },
    `content-column-${contentColumn}`,
    `scrim-gradient-${scrimGradient}`,
  ]}
  style={[contentWidthCss && `--fc-content-width: ${contentWidthCss}`, `--fc-pt: ${padTopCss}`, `--fc-pb: ${padBottomCss}`, `--fc-offset-top: ${offsetTopCss}`, `--fc-inset: ${insetCss}`, `--fc-cta-radius: ${ctaRadiusCss}`].filter(Boolean).join('; ')}
>
  {bgImage && <img class="hero__bg" src={assertSafeUrl(bgImage.src, 'hero image src')} alt={bgImage.alt} />}
  {bgImage && scrim !== 'none' && <div class="hero__scrim" aria-hidden="true"></div>}
  {bgImage && scrimGradient !== 'none' && <div class="hero__scrim-top" aria-hidden="true"></div>}

  <div class="hero__inner">
    {eyebrow?.text && !eyebrow.position && <p class="hero__eyebrow" style={eyebrowStyle}>{eyebrow.text}</p>}
    {!heading.position && <h1 class:list={['hero__heading', `case-${headingCase}`]} style={headingStyle}>{headingLines.map((line, i) => <Fragment>{i > 0 && <br />}{line}</Fragment>)}</h1>}
    {divider === 'rule' && <hr class="hero__divider" />}
    {portrait && <img class:list={['hero__portrait', `portrait-${portraitShape}`]} src={assertSafeUrl(portrait.src, 'hero portrait src')} alt={portrait.alt} />}
    {subhead?.text && !subhead.position && <p class="hero__subhead" style={subheadStyle}>{subhead.text}</p>}
    {cta?.label && cta.href && !cta.position && <a class:list={['hero__cta']} style={ctaStyle} href={assertSafeUrl(cta.href, 'hero cta href')}>{cta.label}</a>}
  </div>

  {anyPositioned && (
    <div class="hero__stack">
      {eyebrow?.text && eyebrow.position && <p class="hero__eyebrow hero__slot--positioned" style={withPos(eyebrowStyle, eyebrow)}>{eyebrow.text}</p>}
      {heading.position && <h1 class:list={['hero__heading', `case-${headingCase}`, 'hero__slot--positioned']} style={withPos(headingStyle, heading)}>{headingLines.map((line, i) => <Fragment>{i > 0 && <br />}{line}</Fragment>)}</h1>}
      {subhead?.text && subhead.position && <p class="hero__subhead hero__slot--positioned" style={withPos(subheadStyle, subhead)}>{subhead.text}</p>}
      {cta?.label && cta.href && cta.position && <a class:list={['hero__cta', 'hero__slot--positioned']} style={withPos(ctaStyle, cta)} href={assertSafeUrl(cta.href, 'hero cta href')}>{cta.label}</a>}
    </div>
  )}
</section>

<style>
  .hero { position: relative; background: var(--color-bg); color: var(--color-text); overflow: hidden; padding-top: var(--fc-pt); padding-bottom: var(--fc-pb); }
  .hero.surface-subtle { background: var(--color-surface-subtle); }
  .hero.surface-inverse { background: var(--color-surface-inverse); color: var(--color-bg); }
  .hero.surface-accent { background: var(--color-accent); color: var(--color-bg); }

  /* Height dial: `fold` fills the viewport to the fold and centres the content
     vertically. `box-sizing: border-box` (base reset) keeps the padding inside
     the 100vh, so the band is exactly the fold. */
  .hero.height-fold {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  /* As a flex item the inner would shrink to its content; `width: 100%` keeps it
     spanning the container so the content stays left-aligned with bands below. */
  .hero.height-fold .hero__inner { width: 100%; margin-top: var(--fc-offset-top); }

  /* Content anchor (REQ-32): where the content sits within a `fold` band. */
  .hero.height-fold.anchor-top { justify-content: flex-start; }
  .hero.height-fold.anchor-bottom { justify-content: flex-end; }

  /* Fixed top inset for a `fold` hero's content (REQ-49): a token-backed distance
     from the band top, independent of the flex anchor. */


  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  /* Legibility scrim (REQ-32; REQ-36): a dark tint painted over the image at a
     strength set by the scrim dial. Keyed to `--color-scrim`. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--color-scrim);
  }
  .hero.scrim-light .hero__scrim { opacity: 0.2; }
  .hero.scrim-medium .hero__scrim { opacity: 0.35; }
  .hero.scrim-strong .hero__scrim { opacity: 0.55; }
  .hero.scrim-heavy .hero__scrim { opacity: 0.68; }
  /* Top-of-band gradient scrim (REQ-36): a downward dark gradient over the flat
     scrim, darkening the top edge (behind the nav) and fading out ~40% down. */
  .hero__scrim-top {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: linear-gradient(to bottom, var(--color-scrim), transparent 38%);
  }
  .hero.scrim-gradient-top .hero__scrim-top { opacity: 0.5; }
  /* Positioned-object canvas (REQ-52): a full-band absolute stack (mirrors
     `.fc-layer__stack`) holding the slots that carry a `position`. Each slot is
     placed by the framework `--fc-*` custom properties written onto its inline
     style; `x`/`y`/`w` are band percentages. The stack sits at the same z-level
     as the flow inner, above the background/scrim. */
  .hero__stack { position: absolute; inset: 0; z-index: 1; }
  .hero__slot--positioned {
    position: absolute;
    left: var(--fc-x, 0%);
    top: var(--fc-y, 0%);
    width: var(--fc-w, auto);
    z-index: var(--fc-z, 1);
    transform: rotate(var(--fc-rotate, 0deg));
    margin: 0;
    max-width: none;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: var(--container-6xl);
    margin-inline: auto;
    padding-inline: var(--fc-inset);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  /* Content horizontal inset / gutter (REQ-49 cap 5): the `padding-inline` as a
     token step, so the front-door left edge can align to a reference's gutter. */
  .hero.align-center .hero__inner { align-items: center; text-align: center; }
  /* Content-column placement (REQ-36): `left` drops the auto start-margin so the
     capped column hugs the band's left gutter. */
  .hero.content-column-left .hero__inner { margin-inline: 0 auto; }

  /* Divider rule (REQ-36): a thin rule between heading and subhead inheriting the
     surface text colour, capped to a short measure. */
  .hero__divider {
    width: 32rem;
    max-width: 100%;
    height: 0;
    margin: 0;
    border: 0;
    border-top: 2px solid currentColor;
  }

  /* Foreground portrait (REQ-36) — an attribution/testimonial avatar above the
     subhead. `circle` crops it round; a thin surface-colour ring lifts it off a
     busy background image. */
  .hero__portrait {
    display: block;
    width: 7rem;
    height: 7rem;
    object-fit: cover;
    margin: 0 0 var(--space-4);
    border: 2px solid currentColor;
  }
  .hero__portrait.portrait-circle { border-radius: 50%; }
  .hero__portrait.portrait-square { border-radius: var(--radius-md); }
  .hero.align-center .hero__portrait { margin-inline: auto; }

  /* REQ-50 — base slot styling supplies the *defaults* an omitting run inherits;
     any axis a styled run sets is emitted as an inline `style` and overrides the
     base. Intrinsic typography (family/size/weight/colour/tracking/leading/
     gradient) now lives on the run, not on a dial. */
  /* REQ-50: the eyebrow renders as authored — its family/size/weight/colour/
     tracking come from the styled run, and the literal DOM text (incl. its case)
     is preserved. Un-styled eyebrows fall back to a small semibold muted kicker.
     (Previously this slot force-uppercased its text, which contradicted REQ-50's
     run-controlled style and the headingCase literal-text rule.) */
  .hero__eyebrow {
    margin: 0;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-muted);
  }
  .hero__heading {
    margin: 0;
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    /* Default responsive size when the run omits `fontSizePx`; a literal px on
       the run replaces this with a fixed size (REQ-50 agreed fork). */
    font-size: clamp(var(--font-size-3xl), 6vw, var(--font-size-4xl));
  }
  /* Heading letter-case (REQ-36) — uppercases the rendered heading; DOM literal. */
  .hero__heading.case-upper { text-transform: uppercase; }

  .hero__subhead { margin: 0; font-size: var(--font-size-xl); }
  .hero.align-center .hero__subhead { margin-inline: auto; }
  /* Subhead/body content-column width (REQ-49 capability, REQ-55 mechanism): caps
     the measure to `--fc-content-width` (a named-step token or a literal), set as
     an inline custom property; `bleed`/absent leaves the column uncapped. */
  .hero.has-content-width .hero__subhead { max-width: var(--fc-content-width); }

  .hero__cta {
    display: inline-block;
    background: var(--color-primary);
    color: var(--color-bg);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--fc-cta-radius, var(--radius-md));
    font-weight: var(--font-weight-semibold);
    text-align: center;
    text-decoration: none;
  }
  /* CTA corner shape (REQ-36) — `round` is the pill radius above; `square`
     hard-corners; `soft` is the reference's barely-rounded 2px button. */
  /* The inner is a stretch flex column, which would stretch the CTA into a
     full-width bar. Pin it to the content-start edge so it hugs its label. */
  .hero.align-left .hero__cta { align-self: flex-start; }
</style>
