---
import type { AssetRef } from '@1stcontact/site-schema'
import { renderMarkdown } from '../markdown'

interface ServiceItem {
  icon?: AssetRef | string
  title: string
  body: string
  /** Per-card type scale (REQ-20) — `lg` marks a featured card (larger title,
   *  body, badge); `md` (default) is the standard scale. */
  size?: 'sm' | 'md' | 'lg'
  cta?: { label: string; href: string }
  /** Accent left-border colour (REQ-26) — a palette-role name, not a raw colour. */
  accent?: 'primary' | 'accent' | 'muted' | 'secondary' | 'neutral-cool'
  /** Card fill (REQ-20, REQ-32) — `muted`/`neutral-cool` are filled panels. */
  surface?: 'default' | 'muted' | 'neutral-cool'
  /** Status pill shown top-right (REQ-26). */
  badge?: { label: string; variant?: 'neutral' | 'primary' | 'accent' | 'secondary' }
  /** Body items rendered as ✓ checks (REQ-26); tick colour follows the badge. */
  checklist?: string[]
}

interface Props {
  variant?: string
  dials?: Record<string, string>
  content: {
    heading?: string
    subhead?: string
    items: ServiceItem[]
  }
}

const { variant = 'three-col', dials = {}, content } = Astro.props as Props
const surface = dials.surface ?? 'default'
const gap = dials.gap ?? 'normal'
// Card type scale (REQ-20): `md` preserves the prior scale; `lg`/`sm` step the
// card heading/subhead/badge/checklist typography up/down one notch.
const size = dials.size ?? 'md'
// Constrained content column (REQ-45): `default` fills the frame; a capped
// column pins to the frame's left gutter (the section flex default).
const contentWidth = dials.contentWidth ?? 'default'
const spacingTop = dials.spacingTop ?? 'lg'
const spacingBottom = dials.spacingBottom ?? 'lg'

const { heading } = content
const items = content.items ?? []
const subheadHtml = content.subhead ? await renderMarkdown(content.subhead) : undefined
// Pre-render each card's markdown body in the frontmatter (async).
const cards = await Promise.all(
  items.map(async (item) => ({ item, bodyHtml: await renderMarkdown(item.body) })),
)

function iconIsImage(icon: ServiceItem['icon']): icon is AssetRef {
  return typeof icon === 'object' && icon !== null
}
---

<section
  class:list={[
    'services-grid',
    `variant-${variant}`,
    `surface-${surface}`,
    `gap-${gap}`,
    `size-${size}`,
    `content-width-${contentWidth}`,
    `spacing-top-${spacingTop}`,
    `spacing-bottom-${spacingBottom}`,
  ]}
>
  <div class="services-grid__inner">
    {heading && <h2 class="services-grid__heading">{heading}</h2>}
    {subheadHtml && <div class="services-grid__subhead" set:html={subheadHtml} />}

    <ul class="services-grid__cards">
      {cards.map(({ item, bodyHtml }) => (
        <li
          class:list={[
            'services-grid__card',
            `card-size-${item.size ?? 'md'}`,
            item.accent && `has-accent accent-${item.accent}`,
            item.surface && item.surface !== 'default' && `surface-${item.surface}`,
            // The ✓ checklist ticks take the badge variant's colour.
            item.badge && `status-${item.badge.variant ?? 'neutral'}`,
          ]}
        >
          {item.badge && (
            <span class:list={['services-grid__badge', `badge-${item.badge.variant ?? 'neutral'}`]}>
              {item.badge.label}
            </span>
          )}
          {item.icon && (
            <div class="services-grid__icon">
              {iconIsImage(item.icon)
                ? <img src={item.icon.src} alt={item.icon.alt} loading="lazy" decoding="async" />
                : <span aria-hidden="true">{item.icon}</span>}
            </div>
          )}
          <h3 class="services-grid__card-title">{item.title}</h3>
          <div class="services-grid__card-body" set:html={bodyHtml} />
          {item.checklist && item.checklist.length > 0 && (
            <ul class="services-grid__checklist">
              {item.checklist.map((line) => (
                <li class="services-grid__check">
                  <span class="services-grid__check-mark">✓</span>
                  <span class="services-grid__check-text">{line}</span>
                </li>
              ))}
            </ul>
          )}
          {item.cta && (
            <a class="services-grid__card-cta" href={item.cta.href}>{item.cta.label}</a>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services-grid { background: var(--color-bg); color: var(--color-text); }
  .services-grid.surface-subtle { background: var(--color-surface-subtle); }
  .services-grid.surface-inverse { background: var(--color-surface-inverse); color: var(--color-bg); }
  .services-grid.surface-accent { background: var(--color-accent); color: var(--color-bg); }

  .services-grid.spacing-top-none { padding-top: var(--space-0); }
  .services-grid.spacing-top-sm { padding-top: var(--space-4); }
  .services-grid.spacing-top-md { padding-top: var(--space-8); }
  .services-grid.spacing-top-lg { padding-top: var(--space-16); }
  .services-grid.spacing-top-xl { padding-top: var(--space-24); }
  .services-grid.spacing-bottom-none { padding-bottom: var(--space-0); }
  .services-grid.spacing-bottom-sm { padding-bottom: var(--space-4); }
  .services-grid.spacing-bottom-md { padding-bottom: var(--space-8); }
  .services-grid.spacing-bottom-lg { padding-bottom: var(--space-16); }
  .services-grid.spacing-bottom-xl { padding-bottom: var(--space-24); }

  .services-grid__inner {
    max-width: var(--container-default);
    margin-inline: auto;
    padding-inline: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  /* Constrained content column (REQ-45): the inner stays a full-width frame
     while these cap the content (heading, intro, cards) to a narrower measure.
     The inner is a flex column at its default cross-start, so a capped child
     pins to the frame's left gutter — the same edge as the header/hero content
     — reading as a narrow left-aligned column. `content-width-default` sets no
     cap, so a grid that omits the dial fills the frame and is unchanged.
     Token-backed widths, no raw CSS. */
  .services-grid.content-width-narrow .services-grid__inner > * { max-width: var(--container-narrow); width: 100%; }
  .services-grid.content-width-wide .services-grid__inner > * { max-width: var(--container-wide); width: 100%; }

  .services-grid__heading {
    margin: 0;
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-3xl);
    line-height: var(--line-height-tight);
  }
  .services-grid__subhead { color: var(--color-muted); max-width: 60ch; }

  .services-grid__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
  }
  .services-grid.gap-tight .services-grid__cards { gap: var(--space-3); }
  .services-grid.gap-normal .services-grid__cards { gap: var(--space-6); }
  .services-grid.gap-loose .services-grid__cards { gap: var(--space-8); }

  /* Mobile-first: single column by default, multi-column from md up. The
     `stacked` variant (REQ-30) opts out of the multi-column rules entirely, so
     each card stays full-width in one column at every breakpoint. */
  @media (min-width: 768px) {
    .services-grid.variant-three-col .services-grid__cards { grid-template-columns: repeat(3, 1fr); }
    .services-grid.variant-two-col .services-grid__cards { grid-template-columns: repeat(2, 1fr); }
    .services-grid.variant-stacked .services-grid__cards { grid-template-columns: 1fr; }
  }

  .services-grid__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  /* Accent left border (REQ-26) — a thicker rule keyed to a semantic token. */
  .services-grid__card.has-accent { border-left-width: var(--space-1); }
  .services-grid__card.accent-primary { border-left-color: var(--color-primary); }
  .services-grid__card.accent-accent { border-left-color: var(--color-accent); }
  .services-grid__card.accent-muted { border-left-color: var(--color-muted); }
  .services-grid__card.accent-secondary { border-left-color: var(--color-secondary); }
  .services-grid__card.accent-neutral-cool { border-left-color: var(--color-neutral-cool); }

  /* Filled panel card (REQ-20, REQ-32) — a subtle neutral tint distinguishing it
     from the standard surface cards (the "What We're Exploring" panel).
     `neutral-cool` keys the same tint to the cool-neutral role for a slate panel. */
  .services-grid__card.surface-muted {
    background: color-mix(in srgb, var(--color-muted) 8%, #ffffff);
  }
  .services-grid__card.surface-neutral-cool {
    background: color-mix(in srgb, var(--color-neutral-cool) 12%, #ffffff);
  }

  /* Status badge (REQ-26) — a pill in the card's top-right corner. */
  .services-grid__badge {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-tight);
    white-space: nowrap;
  }
  /* Soft pills (REQ-20): a light tint of the role behind the role-coloured
     label, matching the captured badges (e.g. `bg-blue-100 text-blue-700`). */
  .services-grid__badge.badge-neutral { background: var(--color-surface-subtle); color: var(--color-muted); }
  .services-grid__badge.badge-primary {
    background: color-mix(in srgb, var(--color-primary) 16%, #ffffff);
    color: var(--color-primary);
  }
  .services-grid__badge.badge-accent {
    background: color-mix(in srgb, var(--color-accent) 22%, #ffffff);
    color: color-mix(in srgb, var(--color-accent) 65%, #000000);
  }
  .services-grid__badge.badge-secondary {
    background: color-mix(in srgb, var(--color-secondary) 16%, #ffffff);
    color: var(--color-secondary);
  }

  /* Checklist (REQ-26) — green ✓ items keyed to the theme primary. */
  .services-grid__checklist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  /* The ✓ is a real leading text run (a `<span>`), not a `::before` pseudo —
     a pseudo-element's glyph is absent from the DOM / accessibility tree and
     from rendered-text extraction, so a faithful-repro capture can't see it.
     The mark is `flex: none` so wrapped body text stays aligned past it. */
  .services-grid__check {
    display: flex;
    gap: var(--space-2);
    line-height: var(--line-height-relaxed);
  }
  .services-grid__check-mark {
    flex: none;
    color: var(--color-primary);
    /* Regular weight (REQ-20): the captured ✓ is a normal-weight glyph; a bold
       tick reads heavier than the reference. Colour still carries the emphasis. */
    font-weight: var(--font-weight-regular);
  }
  /* Tick colour follows the card's badge variant (REQ-20): a card marked
     "coming soon" (secondary/blue) gets blue ticks, matching the reference. */
  .services-grid__card.status-accent .services-grid__check-mark { color: var(--color-accent); }
  .services-grid__card.status-secondary .services-grid__check-mark { color: var(--color-secondary); }
  .services-grid__card.status-neutral .services-grid__check-mark { color: var(--color-muted); }

  .services-grid__icon img { display: block; height: var(--space-12); width: auto; }
  .services-grid__icon span { font-size: var(--font-size-3xl); line-height: 1; }
  .services-grid__card-title {
    margin: 0;
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-semibold);
  }

  /* Grid intro scale (REQ-20 grid `size` dial) — sizes the grid's own subhead
     (the intro line under the heading). `md` (default) preserves the prior
     scale so sites that don't set the dial are unchanged; `lg`/`sm` step it
     up/down. Card typography is a *separate*, per-card axis (below) because a
     reference grid mixes standard and featured cards under one intro. */
  .services-grid.size-sm .services-grid__subhead { font-size: var(--font-size-sm); }
  .services-grid.size-md .services-grid__subhead { font-size: var(--font-size-base); }
  .services-grid.size-lg .services-grid__subhead { font-size: var(--font-size-lg); }

  /* Per-card type scale (REQ-20 per-card `size` field) — a featured card
     (`lg`) reads larger than the standard cards beside it: bigger title, body,
     badge, and a tighter checklist rhythm. `md` (default / absent) is the prior
     fixed scale, so cards that don't set `size` are unchanged. This is what lets
     one grid carry both headline offerings and a quiet companion panel, exactly
     as the gigabytealchemy "What We're Building" grid does. */
  .services-grid__card.card-size-sm .services-grid__card-title { font-size: var(--font-size-lg); }
  .services-grid__card.card-size-md .services-grid__card-title { font-size: var(--font-size-xl); }
  .services-grid__card.card-size-lg .services-grid__card-title { font-size: var(--font-size-2xl); }

  .services-grid__card.card-size-sm .services-grid__card-body { font-size: var(--font-size-sm); }
  /* A featured card's body reads as a lead line + description, mirroring the
     hero subhead: the first paragraph is the larger lead, following paragraphs
     the smaller body copy — so a headline offering's opening line stands out. */
  .services-grid__card.card-size-lg .services-grid__card-body p:first-child {
    font-size: var(--font-size-lg);
    line-height: var(--line-height-normal);
  }
  .services-grid__card.card-size-lg .services-grid__card-body p + p {
    font-size: var(--font-size-base);
    line-height: var(--line-height-normal);
  }

  .services-grid__card.card-size-lg .services-grid__badge {
    font-size: var(--font-size-sm);
    line-height: var(--line-height-normal);
  }
  .services-grid__card.card-size-lg .services-grid__check { line-height: var(--line-height-normal); }
  .services-grid__card-body { line-height: var(--line-height-relaxed); color: inherit; }
  .services-grid__card-cta {
    margin-top: auto;
    align-self: flex-start;
    color: var(--color-primary);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }
</style>
