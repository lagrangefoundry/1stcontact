---
import type { AssetRef } from '@1stcontact/site-schema'
import { renderMarkdown } from '../markdown'
import { assertSafeUrl } from '../safety'
import { resolveContainerWidth } from '../dials'
import { resolveTextStyle, type TextRun } from '../text-style'

interface ServiceItem {
  icon?: AssetRef | string
  /** Card top-media image (REQ-36) — a full-width photo atop the card. */
  image?: AssetRef
  title: TextRun
  body: string
  bodyStyle?: TextRun
  cta?: TextRun
  /** Accent left-border colour (REQ-26) — a palette-role name, not a raw colour. */
  accent?: 'primary' | 'accent' | 'muted' | 'secondary' | 'neutral-cool'
  /** Card fill (REQ-20, REQ-32) — `muted`/`neutral-cool` are filled panels. */
  surface?: 'default' | 'muted' | 'neutral-cool'
  /** Status pill shown top-right (REQ-26). `labelStyle` is the REQ-56 per-instance
   *  escape hatch — a style-only run overriding the theme `badge` subscale here. */
  badge?: {
    label: string
    variant?: 'neutral' | 'primary' | 'accent' | 'secondary'
    labelStyle?: TextRun
  }
  /** Body items rendered as ✓ checks (REQ-26); tick colour follows the badge. */
  checklist?: string[]
  /** REQ-56 per-instance escape hatch — a style-only run overriding the theme
   *  `checklist` subscale for this card's checklist items. */
  checklistStyle?: TextRun
}

interface Props {
  variant?: string
  dials?: Record<string, string>
  content: {
    heading?: TextRun
    subhead?: string
    subheadStyle?: TextRun
    items: ServiceItem[]
    /** Section-level CTA button rendered below the grid (REQ-36). */
    cta?: TextRun
  }
}

const { variant = 'three-col', dials = {}, content } = Astro.props as Props
const surface = dials.surface ?? 'default'
const gap = dials.gap ?? 'normal'
// Grid-wide card chrome (REQ-36 / CAP-1).
const cardSurface = dials.cardSurface ?? 'default'
// Heading letter-case (REQ-36) — uppercases the grid heading + card titles.
const headingCase = dials.headingCase ?? 'normal'
// Icon rendering (REQ-36).
const iconFont = dials.iconFont ?? 'default'
// Constrained content column (REQ-45 capability, REQ-55 scale + literal). Resolves
// to a max-width length applied via `--fc-content-width`, or null (fills frame).
const contentWidthCss = resolveContainerWidth(dials.contentWidth)
// Card icon layout (REQ-36).
const iconLayout = dials.iconLayout ?? 'top'
// Constrained-column alignment (REQ-36).
const contentAlign = dials.contentAlign ?? 'left'
const spacingTop = dials.spacingTop ?? 'lg'
const spacingBottom = dials.spacingBottom ?? 'lg'

const { heading } = content
const sectionCta = content.cta
const items = content.items ?? []
const subheadHtml = content.subhead ? await renderMarkdown(content.subhead) : undefined
// Pre-render each card's markdown body + resolve its styled runs (async body).
const cards = await Promise.all(
  items.map(async (item) => ({
    item,
    bodyHtml: await renderMarkdown(item.body),
    titleStyle: resolveTextStyle(item.title),
    bodyStyle: resolveTextStyle(item.bodyStyle),
    ctaStyle: resolveTextStyle(item.cta),
    // REQ-56 per-instance escape hatches → inline style (beats the subscale rule).
    badgeLabelStyle: resolveTextStyle(item.badge?.labelStyle),
    checklistStyle: resolveTextStyle(item.checklistStyle),
  })),
)

// REQ-50 — section-level styled runs → inline `style`.
const headingStyle = resolveTextStyle(heading)
const subheadStyle = resolveTextStyle(content.subheadStyle)
const sectionCtaStyle = resolveTextStyle(sectionCta)

function iconIsImage(icon: ServiceItem['icon']): icon is AssetRef {
  return typeof icon === 'object' && icon !== null
}
---

<section
  class:list={[
    'services-grid',
    `variant-${variant}`,
    `surface-${surface}`,
    `card-surface-${cardSurface}`,
    `case-${headingCase}`,
    `icon-font-${iconFont}`,
    `icon-layout-${iconLayout}`,
    `gap-${gap}`,
    { 'has-content-width': contentWidthCss !== null },
    `content-align-${contentAlign}`,
    `spacing-top-${spacingTop}`,
    `spacing-bottom-${spacingBottom}`,
  ]}
  style={contentWidthCss ? `--fc-content-width: ${contentWidthCss}` : undefined}
>
  <div class="services-grid__inner">
    {heading?.text && <h2 class="services-grid__heading" style={headingStyle}>{heading.text}</h2>}
    {subheadHtml && <div class="services-grid__subhead" style={subheadStyle} set:html={subheadHtml} />}

    <ul class="services-grid__cards">
      {cards.map(({ item, bodyHtml, titleStyle, bodyStyle, ctaStyle, badgeLabelStyle, checklistStyle }) => (
        <li
          class:list={[
            'services-grid__card',
            item.accent && `has-accent accent-${item.accent}`,
            item.surface && item.surface !== 'default' && `surface-${item.surface}`,
            // The ✓ checklist ticks take the badge variant's colour.
            item.badge && `status-${item.badge.variant ?? 'neutral'}`,
          ]}
        >
          {item.image && (
            <img
              class="services-grid__media"
              src={assertSafeUrl(item.image.src, 'services-grid media src')}
              alt={item.image.alt}
              decoding="async"
            />
          )}
          {item.badge && (
            <span class:list={['services-grid__badge', `badge-${item.badge.variant ?? 'neutral'}`]} style={badgeLabelStyle}>
              {item.badge.label}
            </span>
          )}
          {item.icon && (
            <div class="services-grid__icon">
              {iconIsImage(item.icon)
                ? <img src={assertSafeUrl(item.icon.src, 'services-grid icon src')} alt={item.icon.alt} loading="lazy" decoding="async" />
                : <span aria-hidden="true">{item.icon}</span>}
            </div>
          )}
          <h3 class="services-grid__card-title" style={titleStyle}>{item.title?.text}</h3>
          <div class="services-grid__card-body" style={bodyStyle} set:html={bodyHtml} />
          {item.checklist && item.checklist.length > 0 && (
            <ul class="services-grid__checklist">
              {item.checklist.map((line) => (
                <li class="services-grid__check" style={checklistStyle}>
                  <span class="services-grid__check-mark">✓</span>
                  <span class="services-grid__check-text">{line}</span>
                </li>
              ))}
            </ul>
          )}
          {item.cta?.label && item.cta.href && (
            <a class="services-grid__card-cta" style={ctaStyle} href={assertSafeUrl(item.cta.href, 'services-grid cta href')}>{item.cta.label}</a>
          )}
        </li>
      ))}
    </ul>
    {sectionCta?.label && sectionCta.href && (
      <a class="services-grid__cta" style={sectionCtaStyle} href={assertSafeUrl(sectionCta.href, 'services-grid section cta href')}>{sectionCta.label}</a>
    )}
  </div>
</section>

<style>
  .services-grid { background: var(--color-bg); color: var(--color-text); }
  .services-grid.surface-subtle { background: var(--color-surface-subtle); }
  .services-grid.surface-inverse { background: var(--color-surface-inverse); color: var(--color-bg); }
  .services-grid.surface-accent { background: var(--color-accent); color: var(--color-bg); }

  .services-grid.spacing-top-none { padding-top: var(--space-0); }
  .services-grid.spacing-top-sm { padding-top: var(--space-4); }
  .services-grid.spacing-top-md { padding-top: var(--space-8); }
  .services-grid.spacing-top-lg { padding-top: var(--space-16); }
  .services-grid.spacing-top-xl { padding-top: var(--space-24); }
  .services-grid.spacing-top-2xl { padding-top: var(--space-32); }
  .services-grid.spacing-top-3xl { padding-top: var(--space-48); }
  .services-grid.spacing-bottom-none { padding-bottom: var(--space-0); }
  .services-grid.spacing-bottom-sm { padding-bottom: var(--space-4); }
  .services-grid.spacing-bottom-md { padding-bottom: var(--space-8); }
  .services-grid.spacing-bottom-lg { padding-bottom: var(--space-16); }
  .services-grid.spacing-bottom-xl { padding-bottom: var(--space-24); }
  .services-grid.spacing-bottom-2xl { padding-bottom: var(--space-32); }
  .services-grid.spacing-bottom-3xl { padding-bottom: var(--space-48); }

  .services-grid__inner {
    max-width: var(--container-6xl);
    margin-inline: auto;
    padding-inline: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  /* Constrained content column (REQ-45 capability, REQ-55 mechanism): caps the
     content children to `--fc-content-width` (a named-step token or a literal). */
  .services-grid.has-content-width .services-grid__inner > * { max-width: var(--fc-content-width); width: 100%; }
  .services-grid.content-align-center .services-grid__inner { align-items: center; }
  .services-grid.content-align-center .services-grid__inner > * { margin-inline: auto; }

  /* REQ-50 — base slot styling supplies the defaults an omitting run inherits;
     any axis the styled run sets overrides via inline `style`. */
  .services-grid__heading {
    margin: 0;
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-3xl);
    line-height: var(--line-height-tight);
  }
  /* Heading letter-case (REQ-36) — uppercases the grid heading + card titles;
     the DOM text stays literal (a treatment, not a report field). */
  .services-grid.case-upper .services-grid__heading,
  .services-grid.case-upper .services-grid__card-title { text-transform: uppercase; }
  .services-grid__subhead { color: var(--color-muted); max-width: 60ch; }

  .services-grid__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
  }
  .services-grid.gap-tight .services-grid__cards { gap: var(--space-3); }
  .services-grid.gap-normal .services-grid__cards { gap: var(--space-6); }
  .services-grid.gap-loose .services-grid__cards { gap: var(--space-8); }
  .services-grid.gap-airy .services-grid__cards { gap: var(--space-16); }

  /* Mobile-first: single column by default, multi-column from md up. */
  @media (min-width: 768px) {
    .services-grid.variant-three-col .services-grid__cards { grid-template-columns: repeat(3, 1fr); }
    .services-grid.variant-two-col .services-grid__cards { grid-template-columns: repeat(2, 1fr); }
    .services-grid.variant-stacked .services-grid__cards { grid-template-columns: 1fr; }
  }

  .services-grid__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  /* Bare cards (REQ-36 / CAP-1): strip the fill/border/radius/padding. */
  .services-grid.card-surface-bare .services-grid__card {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
  }

  /* Icon-left card layout (REQ-36). */
  .services-grid.icon-layout-left .services-grid__card {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--space-4);
    row-gap: var(--space-3);
    align-items: start;
  }
  .services-grid.icon-layout-left .services-grid__icon { grid-column: 1; grid-row: 1; margin: 0; }
  .services-grid.icon-layout-left .services-grid__card-title { grid-column: 2; grid-row: 1; align-self: center; min-width: 0; }
  .services-grid.icon-layout-left .services-grid__card-body { grid-column: 1 / -1; }
  .services-grid__card { min-width: 0; }
  .services-grid.card-surface-bare .services-grid__badge { display: none; }

  /* Accent left border (REQ-26) — a thicker rule keyed to a semantic token. */
  .services-grid__card.has-accent { border-left-width: var(--space-1); }
  .services-grid__card.accent-primary { border-left-color: var(--color-primary); }
  .services-grid__card.accent-accent { border-left-color: var(--color-accent); }
  .services-grid__card.accent-muted { border-left-color: var(--color-muted); }
  .services-grid__card.accent-secondary { border-left-color: var(--color-secondary); }
  .services-grid__card.accent-neutral-cool { border-left-color: var(--color-neutral-cool); }

  /* Filled panel card (REQ-20, REQ-32). */
  .services-grid__card.surface-muted {
    background: color-mix(in srgb, var(--color-muted) 8%, #ffffff);
  }
  .services-grid__card.surface-neutral-cool {
    background: color-mix(in srgb, var(--color-neutral-cool) 12%, #ffffff);
  }

  /* Status badge (REQ-26) — a pill in the card's top-right corner. */
  .services-grid__badge {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    /* Badge label type from the theme `badge` subscale (REQ-56) — fixing the
       subscale corrects every badge instance; a per-instance `badge.labelStyle`
       overrides one. Family defaults to inherit when the subscale sets none. */
    font-family: var(--subscale-badge-font-family, inherit);
    font-size: var(--subscale-badge-font-size);
    font-weight: var(--subscale-badge-font-weight);
    line-height: var(--subscale-badge-line-height);
    letter-spacing: var(--subscale-badge-letter-spacing);
    white-space: nowrap;
  }
  .services-grid__badge.badge-neutral { background: var(--color-surface-subtle); color: var(--color-muted); }
  .services-grid__badge.badge-primary {
    background: color-mix(in srgb, var(--color-primary) 16%, #ffffff);
    color: var(--color-primary);
  }
  .services-grid__badge.badge-accent {
    background: color-mix(in srgb, var(--color-accent) 22%, #ffffff);
    color: color-mix(in srgb, var(--color-accent) 65%, #000000);
  }
  .services-grid__badge.badge-secondary {
    background: color-mix(in srgb, var(--color-secondary) 16%, #ffffff);
    color: var(--color-secondary);
  }

  /* Checklist (REQ-26) — ✓ items; the tick is a real leading text run. */
  .services-grid__checklist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .services-grid__check {
    display: flex;
    gap: var(--space-2);
    /* Checklist item type from the theme `checklist` subscale (REQ-56); a
       per-instance `checklist.itemStyle` overrides one. */
    font-family: var(--subscale-checklist-font-family, inherit);
    font-size: var(--subscale-checklist-font-size);
    font-weight: var(--subscale-checklist-font-weight);
    line-height: var(--subscale-checklist-line-height);
    letter-spacing: var(--subscale-checklist-letter-spacing);
  }
  .services-grid__check-mark {
    flex: none;
    color: var(--color-primary);
    font-weight: var(--font-weight-regular);
  }
  /* Tick colour follows the card's badge variant (REQ-20). */
  .services-grid__card.status-accent .services-grid__check-mark { color: var(--color-accent); }
  .services-grid__card.status-secondary .services-grid__check-mark { color: var(--color-secondary); }
  .services-grid__card.status-neutral .services-grid__check-mark { color: var(--color-muted); }

  .services-grid__icon img { display: block; height: var(--space-12); width: auto; }
  /* Card top-media (REQ-36) — a full-width square photo atop the card. */
  .services-grid__media {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius-md);
    margin-bottom: var(--space-4);
  }
  /* Section-level CTA (REQ-36) — a centred accent button below the grid. */
  .services-grid__cta {
    display: block;
    width: fit-content;
    margin: var(--space-12) auto 0;
    background: var(--color-accent);
    color: var(--color-bg);
    padding: var(--space-3) var(--space-6);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }
  .services-grid__icon span { font-size: var(--font-size-3xl); line-height: 1; }
  /* Icon-font glyphs (REQ-36). */
  .services-grid.icon-font-icon-font .services-grid__icon span {
    font-family: 'IconFont';
    font-weight: 900;
    color: var(--color-accent);
    font-size: var(--font-size-4xl);
  }
  /* Card title base (REQ-50) — family/weight/size defaults an omitting `title`
     run inherits; the run overrides via inline `style`. */
  .services-grid__card-title {
    margin: 0;
    font-family: var(--font-family-heading);
    font-weight: var(--font-weight-semibold);
    font-size: var(--font-size-xl);
  }
  .services-grid__card-body { font-size: var(--font-size-base); line-height: var(--line-height-relaxed); color: inherit; }
  .services-grid__card-cta {
    margin-top: auto;
    align-self: flex-start;
    color: var(--color-primary);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }
</style>
