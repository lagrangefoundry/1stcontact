bottomPx":96,"leftPx":24,"rightPx":24,"topPx":96},"sizing":{"width":{"maxPx":1160,"mode":"fluid"}}},{"align":"center","axes":{"surfaceFill":"#ffffff"},"children":[{"children":[{"axes":{"color":"#1a3a52","fontSizePx":28,"fontStyle":"italic","fontWeight":600,"lineHeightPx":38},"kind":"text","text":"\"Anyone can fix a leak, but a good bathroom in an old house is a craft.\""},{"axes":{"color":"#4b5563","fontSizePx":15,"fontWeight":400,"lineHeightPx":22},"kind":"text","text":"— Walt Hendricks, who taught Charlie the trade"}],"gapPx":16,"id":"story-quote-left","kind":"container","layout":"stack","padding":{"bottomPx":0,"leftPx":24,"rightPx":0,"topPx":0}},{"children":[{"axes":{"color":"#0369a1","fontSizePx":14,"fontWeight":700,"letterSpacingPx":1.4,"textAlign":"left","textTransform":"uppercase"},"kind":"text","text":"Our Story"},{"axes":{"color":"#1a3a52","fontSizePx":32,"fontWeight":700,"lineHeightPx":40,"textAlign":"left"},"kind":"text","text":"Started with a shoebox of index cards"},{"axes":{"color":"#374151","fontSizePx":17,"fontWeight":400,"lineHeightPx":27},"kind":"text","text":"When Walt Hendricks retired in 2001, he handed Charlie his customers: a shoebox of index cards. That, and a van Charlie painted himself, was the business. We still have the shoebox. Some of those people still call. Their kids call now too."},{"axes":{"color":"#374151","fontSizePx":17,"fontWeight":400,"lineHeightPx":27},"kind":"text","text":"Emma runs the place. She writes your quote, keeps your job on schedule and keeps you posted. Dave came home after four years with a big outfit in San Jose. He knows the newer kit, like tankless heaters and sewer cameras, and Charlie knows the old Santa Cruz houses. Between us there isn't much we haven't seen."},{"axes":{"color":"#1a3a52","fontSizePx":17,"fontWeight":600,"lineHeightPx":27},"kind":"text","text":"Twenty-five years, and we've never advertised. Every job, somebody told somebody."}],"gapPx":24,"id":"story-text-right","kind":"container","layout":