idthPx":1},"borderRadiusPx":12,"surfaceFill":"#ffffff"},"children":[{"axes":{"color":"#0369a1","fontSizePx":18,"fontWeight":400,"lineHeightPx":27},"kind":"text","text":"★★★★★"},{"axes":{"color":"#111827","fontSizePx":18,"fontWeight":400,"lineHeightPx":29},"kind":"text","text":"Another company quoted me $8,500 to replace my sewer line. Charlie ran a camera, found one bad joint and fixed it for under $600. That was three years ago and it's been fine. I tell everyone."},{"axes":{"color":"#1a3a52","fontSizePx":15,"fontWeight":600,"lineHeightPx":22},"kind":"text","text":"Diane W., Soquel"}],"gapPx":16,"id":"review-1","kind":"container","layout":"stack","padding":{"bottomPx":32,"leftPx":32,"rightPx":32,"topPx":32}},{"axes":{"border":{"color":"#e2e8f0","widthPx":1},"borderRadiusPx":12,"surfaceFill":"#ffffff"},"children":[{"axes":{"color":"#0369a1","fontSizePx":18,"fontWeight":400,"lineHeightPx":27},"kind":"text","text":"★★★★★"},{"axes":{"color":"#111827","fontSizePx":18,"fontWeight":400,"lineHeightPx":29},"kind":"text","text":"The leak came back three months later and Charlie came out and fixed it again for nothing. He said \"that's on me.\" That's why I'll never call anyone else."},{"axes":{"color":"#1a3a52","fontSizePx":15,"fontWeight":600,"lineHeightPx":22},"kind":"text","text":"Ray D., Eastside"}],"gapPx":16,"id":"review-2","kind":"container","layout":"stack","padding":{"bottomPx":32,"leftPx":32,"rightPx":32,"topPx":32}}],"gapPx":24,"id":"review-cards","kind":"container","layout":"row","padding":{"bottomPx":0,"leftPx":0,"rightPx":0,"topPx":40},"responsiveLayout":{"keyframes":[{"at":0,"value":"stack"},{"at":768,"value":"row"}]}}],"gapPx":0,"id":"reviews","kind":"container","layout":"stack","padding":{"bottomPx":96,"leftPx":24,"rightPx":24,"topPx":96},"sizing":{"width":{"maxPx":1160,"mode":"fluid"}}},{"align":"center","axes":{"border":{"color":"#e2e8f0","widthPx":1},"surfaceFill":"#ffffff"},"children":[{"axes":{"color":"#4b5563","fontSizePx":14,"fontWeight":400,"lineHeightPx":21,"textAlign":"center"},"kind":"text","text":"Family-owned since 2001 · CSLB Lic. #12394523 · Based on Mission St, Santa Cruz · Serving Santa Cruz, Capitola, Soquel and Live Oak, and further for bigger jobs."}],"distribution":"center","id":"trust-strip","kind":"container","layout":"stack","padding":{"bottomPx":24,"leftPx":24,"rightPx":24,"topPx":24}},{"align":"center","axes":{"surfaceFill":"#ffffff"},"children":[{"axes":{"color":"#1a3a52","fontSizePx":32,"fontWeight":700,"lineHeightPx":40,"textAlign":"center"},"id":"quote-form-heading","kind":"text","text":"Tell us about your project"},{"axes":{"color":"#4b5563","fontSizePx":17,"fontWeight":400,"lineHeightPx":27,"textAlign":"center"},"id":"quote-form-subline","kind":"text","text":"Tell us a little about the job and we'll be in touch to arrange a visit."},{"id":"quote-form-slot","kind":"slot","name":"form"}],"distribution":"center","gapPx":24,"id":"quote-form-section","kind":"container","layout":"stack","padding":{"bottomPx":96,"leftPx":24,"rightPx":24,"topPx":96},"sizing":{"width":{"maxPx":640,"mode":"fluid"}}},{"align":"center","axes":{"surfaceFill":"#1a3a52"},"children":[{"axes":{"color":"#ffffff","fontSizePx":18,"fontWeight":700,"lineHeightPx":26},"kind":"text","text":"Charlie's Plumbing"},{"axes":{"color":"#e5e7eb","fontSizePx":14,"fontWeight":400,"lineHeightPx":22},"kind":"text","text":"2218 Mission St, Santa Cruz, CA"},{"axes":{"color":"#e5e7eb","fontSizePx":14,"fontWeight":600,"lineHeightPx":22},"kind":"text","link":{"href":"tel:+18314444000"},"text":"(831) 444-4000"},{"axes":{"color":"#9ca3af","fontSizePx":12,"fontWeight":400,"lineHeightPx":18},"kind":"text","text":"CSLB Lic. #12394523"},{"axes":{"color":"#9ca3af","fontSizePx":12,"fontWeight":400,"lineHeightPx":18},"kind":"text","text":"Emergencies 8am–10pm, 7 days · Installations weekdays 8am–5pm"},{"axes":{"color":"#9ca3af","fontSizePx":12,"fontWeight":400,"lineHeightPx":18},"kind":"text","text":"Serving Santa Cruz, Capitola, Soquel, Live Oak"}],"distribution":"center","gapPx":24,"id":"footer","kind":"container","layout":"stack","padding":{"bottomPx":48,"leftPx":24,"rightPx":24,"topPx":48}}],"id":"root","kind":"container","layout":"stack"},"resources":{"fonts":[{"family":"Barlow","src":"/_fonts/barlow/Barlow-Regular.woff2","weight":400,"style":"normal"},{"family":"Barlow","src":"/_fonts/barlow/Barlow-SemiBold.woff2","weight":600,"style":"normal"},{"family":"Barlow","src":"/_fonts/barlow/Barlow-Bold.woff2","weight":700,"style":"normal"},{"family":"Barlow","src":"/_fonts/barlow/Barlow-Italic.woff2","weight":400,"style":"italic"},{"family":"Barlow","src":"/_fonts/barlow/Barlow-SemiBoldItalic.woff2","weight":600,"style":"italic"},{"family":"Barlow","src":"/_fonts/barlow/Barlow-BoldItalic.woff2","weight":700,"style":"italic"},{"family":"Oswald","src":"/_fonts/oswald/Oswald%5Bwght%5D.woff2","weight":600,"style":"normal"},{"family":"Oswald","src":"/_fonts/oswald/Oswald%5Bwght%5D.woff2","weight":700,"style":"normal"}]}}}
